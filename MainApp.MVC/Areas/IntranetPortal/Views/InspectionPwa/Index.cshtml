        function showMapLayersPWA() {
            // Create overlay if it doesn't exist
            let overlay = document.getElementById('pwa-layers-overlay');
            if (!overlay) {
                overlay = document.createElement('div');
                overlay.id = 'pwa-layers-overlay';
                overlay.className = 'pwa-layers-overlay';

                const panel = document.createElement('div');
                panel.className = 'pwa-layers-panel';

                const header = document.createElement('div');
                header.className = 'pwa-layers-header';
                header.innerHTML = `
                    <h5><i class="fas fa-layer-group"></i> Map Layers</h5>
                    <button type="button" class="pwa-close-btn" onclick="closeLayersPWA()">
                        <i class="fas fa-times"></i>
                    </button>
                `;

                const content = document.createElement('div');
                content.className = 'pwa-layers-content';
                content.id = 'pwa-layers-content';

                panel.appendChild(header);
                panel.appendChild(content);
                overlay.appendChild(panel);
                document.body.appendChild(overlay);

                // Close on overlay click
                overlay.addEventListener('click', function(e) {
                    if (e.target === overlay) {
                        closeLayersPWA();
                    }
                });
            }

            const sidebarLayersContainer = document.getElementById('sidebar-layers-container');
            const pwaLayersContent = document.getElementById('pwa-layers-content');

            if (sidebarLayersContainer && pwaLayersContent) {
                pwaLayersContent.innerHTML = sidebarLayersContainer.innerHTML;

                if (mapVars.refreshLayerSwitcher) {
                    mapVars.refreshLayerSwitcher();
                    setTimeout(() => {
                        pwaLayersContent.innerHTML = sidebarLayersContainer.innerHTML;
                    }, 100);
                }
            }

            overlay.classList.add('show');
        }

        function closeLayersPWA() {
            const overlay = document.getElementById('pwa-layers-overlay');
            if (overlay) {
                overlay.classList.remove('show');
            }
        }

        function showMapToolsPWA() {
            const existingDropdown = document.getElementById('map-tools-dropdown');

            if (existingDropdown) {
                if (existingDropdown.style.display === 'none' || !existingDropdown.style.display) {
                    existingDropdown.style.display = 'block';
                } else {
                    existingDropdown.style.display = 'none';
                }
                return;
            }

            // Create dropdown
            const dropdown = document.createElement('div');
            dropdown.id = 'map-tools-dropdown';
            dropdown.className = 'map-tools-dropdown';
            dropdown.style.display = 'block';

            // Build tools list
            const tools = [
                { name: 'LayerSwitcher', displayName: 'Layers', icon: 'fa-layer-group' },
                { name: 'LastExtentTool', displayName: 'Last Extent', icon: 'fa-undo' },
                { name: 'ZoomToExtentTool', displayName: 'Zoom to Extent', icon: 'fa-expand' },
                { name: 'MeasureLengthTool', displayName: 'Measure Length', icon: 'fa-ruler' },
                { name: 'MeasureAreaTool', displayName: 'Measure Area', icon: 'fa-vector-square' },
                { name: 'GoToCoordinatesTool', displayName: 'Go to Coordinates', icon: 'fa-crosshairs' },
                { name: 'RegisterDumpsiteTool', displayName: 'Register Dumpsite', icon: 'fa-map-marker-alt' },
                { name: 'HistoricData', displayName: 'Historic Data', icon: 'fa-history' },
                { name: 'DetectionIgnoreZonesTool', displayName: 'Ignore Zones', icon: 'fa-ban' },
                { name: 'DetectionInputImagesTool', displayName: 'Input Images', icon: 'fa-images' }
            ];

            let html = '<div class="list-group">';
            tools.forEach(tool => {
                html += `
                    <button type="button" class="list-group-item list-group-item-action"
                            onclick="activateMapToolPWA('${tool.name}')">
                        <i class="fas ${tool.icon}"></i> ${tool.displayName}
                    </button>
                `;
            });
            html += '</div>';

            dropdown.innerHTML = html;
            document.body.appendChild(dropdown);

            // Close dropdown when clicking outside
            setTimeout(() => {
                document.addEventListener('click', function closeToolsDropdown(e) {
                    if (!dropdown.contains(e.target) && !e.target.closest('.mobile-action-btn')) {
                        dropdown.style.display = 'none';
                        document.removeEventListener('click', closeToolsDropdown);
                    }
                });
            }, 100);
        }

        function activateMapToolPWA(toolName) {
            // Hide the dropdown
            const dropdown = document.getElementById('map-tools-dropdown');
            if (dropdown) {
                dropdown.style.display = 'none';
            }

            if (toolName === 'LayerSwitcher') {
                showMapLayersPWA();
                return;
            }

            // For other tools, use the existing activation logic
            const tool = mapVars.findTool(toolName);
            if (tool) {
                if (!tool.isActive) {
                    mapVars.deactivateTools();
                    tool.activateTool();
                    tool.isActive = true;
                } else {
                    tool.deactivateTool();
                    tool.isActive = false;
                }
            } else {
                console.warn(`Tool ${toolName} not found in mapVars.mapTools`);
            }
        }

