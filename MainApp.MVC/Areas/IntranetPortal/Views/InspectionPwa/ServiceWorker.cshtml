@{
    Layout = null;
}
const staticNexus = "waste-detection-pwa-v3";
const appPath = "@ViewData["AppPath"]";

// Only cache essential PWA resources
const assets = [
    "/IntranetPortal/InspectionPwa/"
];

// Install event
self.addEventListener("install", installEvent => {
    console.log("Service Worker installing...");
    installEvent.waitUntil(
        caches.open(staticNexus)
            .then(cache => {
                console.log("Opened cache");
                return Promise.allSettled(
                    assets.map(asset => {
                        return cache.add(asset)
                            .then(() => console.log(`✅ Cached: ${asset}`))
                            .catch(error => {
                                console.warn(`❌ Failed to cache ${asset}:`, error);
                            });
                    })
                );
            })
            .then(() => {
                console.log("✅ Service Worker installed successfully");
                return self.skipWaiting();
            })
            .catch(error => {
                console.error("❌ Service Worker installation failed:", error);
            })
    );
});

// Activate event - Clean up old caches
self.addEventListener('activate', event => {
    console.log("Service Worker activating...");
    event.waitUntil(
        caches.keys().then(cacheNames => {
            return Promise.all(
                cacheNames
                    .filter(cacheName => {
                        return cacheName.startsWith('waste-detection-pwa-') && cacheName !== staticNexus;
                    })
                    .map(cacheName => {
                        console.log(`🗑️ Deleting old cache: ${cacheName}`);
                        return caches.delete(cacheName);
                    })
            );
        }).then(() => {
            console.log("✅ Service Worker activated");
            return self.clients.claim();
        })
    );
});

// Fetch event - Network first strategy
self.addEventListener("fetch", fetchEvent => {
    const url = new URL(fetchEvent.request.url);

    // Only handle PWA app requests
    if (url.pathname.startsWith('/IntranetPortal/InspectionPwa/')) {
        fetchEvent.respondWith(
            fetch(fetchEvent.request)
                .then(response => {
                    if (response.ok) {
                        const responseClone = response.clone();
                        caches.open(staticNexus).then(cache => {
                            cache.put(fetchEvent.request, responseClone);
                        });
                    }
                    return response;
                })
                .catch(() => {
                    return caches.match(fetchEvent.request)
                        .then(cachedResponse => {
                            if (cachedResponse) {
                                console.log(`📦 Served from cache: ${fetchEvent.request.url}`);
                                return cachedResponse;
                            }
                            if (fetchEvent.request.destination === 'document') {
                                return new Response(
                                    '<h1>Offline</h1><p>This page is not available offline.</p>',
                                    { headers: { 'Content-Type': 'text/html' } }
                                );
                            }
                            return new Response('Network error', { status: 408 });
                        });
                })
        );
    }
});