<!-- Inspection File Upload Modal for PWA -->
<div class="modal fade" id="inspectionFileUploadModal" tabindex="-1" role="dialog" aria-labelledby="inspectionFileUploadModalLabel" aria-hidden="true" style="z-index:2200;">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="inspectionFileUploadModalLabel">
                    <i class="fas fa-upload"></i> Upload Inspection File
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="inspectionFileUploadForm" enctype="multipart/form-data">
                    <input type="hidden" id="uploadInspectionId" />

                    <div class="form-group">
                        <label for="inspectionFileInput">Select File <span class="text-danger">*</span></label>
                        <div class="custom-file">
                            <input type="file" class="custom-file-input" id="inspectionFileInput"
                                   accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.gif,.txt,.xlsx,.xls" required>
                            <label class="custom-file-label" for="inspectionFileInput">Choose file</label>
                        </div>
                        <small class="form-text text-muted">
                            Supported: PDF, Word, Images, Excel, Text files (Max 50MB)
                        </small>
                    </div>

                    <div class="form-group">
                        <label for="inspectionFileDescription">Description</label>
                        <textarea class="form-control" id="inspectionFileDescription" rows="3"
                                  placeholder="Add a description for this inspection file"></textarea>
                    </div>

                    <!-- File preview area -->
                    <div id="filePreview" class="d-none">
                        <div class="card">
                            <div class="card-body p-2">
                                <h6 class="card-title mb-1">File Preview</h6>
                                <div id="fileInfo" class="small text-muted"></div>
                                <div id="imagePreview" class="mt-2"></div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="uploadInspectionFileBtn">
                    <i class="fas fa-upload"></i> Upload
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Complete Inspection Modal -->
<div class="modal fade" id="completeInspectionModal" tabindex="-1" role="dialog" aria-labelledby="completeInspectionModalLabel" aria-hidden="true" style="z-index:2200;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="completeInspectionModalLabel">
                    <i class="fas fa-check"></i> Complete Inspection
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="completeInspectionForm">
                    <input type="hidden" id="completeInspectionId" />

                    <div class="form-group">
                        <label for="inspectionFindings">Findings <span class="text-danger">*</span></label>
                        <textarea class="form-control" id="inspectionFindings" rows="4" required
                                  placeholder="Describe the inspection findings in detail"></textarea>
                    </div>

                    <div class="form-group">
                        <label for="inspectionRecommendations">Recommendations</label>
                        <textarea class="form-control" id="inspectionRecommendations" rows="3"
                                  placeholder="Add recommendations based on findings (optional)"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="completeInspectionBtn">
                    <i class="fas fa-check"></i> Complete Inspection
                </button>
            </div>
        </div>
    </div>
</div>

<!-- View Inspection Files Modal -->
<div class="modal fade" id="viewInspectionFilesModal" tabindex="-1" role="dialog" aria-labelledby="viewInspectionFilesModalLabel" aria-hidden="true" style="z-index:2200;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="viewInspectionFilesModalLabel">
                    <i class="fas fa-file-alt"></i> Inspection Files
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div id="inspectionFilesContent">
                    <!-- Files will be loaded here -->
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    // PWA Inspection File Management JavaScript
    class InspectionFileManager {
        constructor() {
            this.init();
        }

        init() {
            this.bindEvents();
            this.loadMyInspections();
        }

        bindEvents() {
            // File input change event
            $('#inspectionFileInput').on('change', (e) => {
                this.handleFileSelect(e);
            });

            // Upload button click
            $('#uploadInspectionFileBtn').on('click', () => {
                this.uploadInspectionFile();
            });

            // Complete inspection button click
            $('#completeInspectionBtn').on('click', () => {
                this.completeInspection();
            });
        }

        handleFileSelect(event) {
            const file = event.target.files[0];
            const label = $(event.target).next('.custom-file-label');

            if (file) {
                label.text(file.name);
                this.showFilePreview(file);
            } else {
                label.text('Choose file');
                $('#filePreview').addClass('d-none');
            }
        }

        showFilePreview(file) {
            const preview = $('#filePreview');
            const fileInfo = $('#fileInfo');
            const imagePreview = $('#imagePreview');

            // Show file info
            const sizeInMB = (file.size / (1024 * 1024)).toFixed(2);
            fileInfo.html(`
                <strong>Name:</strong> ${file.name}<br>
                <strong>Size:</strong> ${sizeInMB} MB<br>
                <strong>Type:</strong> ${file.type}
            `);

            // Show image preview if it's an image
            imagePreview.empty();
            if (file.type.startsWith('image/')) {
                const reader = new FileReader();
                reader.onload = (e) => {
                    imagePreview.html(`
                        <img src="${e.target.result}" class="img-fluid" style="max-height: 200px;" alt="Preview">
                    `);
                };
                reader.readAsDataURL(file);
            }

            preview.removeClass('d-none');
        }

        showInspectionFileUploadModal(inspectionId) {
            $('#uploadInspectionId').val(inspectionId);
            $('#inspectionFileInput').val('');
            $('#inspectionFileDescription').val('');
            $('.custom-file-label').text('Choose file');
            $('#filePreview').addClass('d-none');
            $('#inspectionFileUploadModal').modal('show');
        }

        uploadInspectionFile() {
            const formData = new FormData();
            const fileInput = document.getElementById('inspectionFileInput');
            const inspectionId = $('#uploadInspectionId').val();
            const description = $('#inspectionFileDescription').val();

            if (!fileInput.files.length) {
                this.showAlert('error', 'Please select a file');
                return;
            }

            if (!inspectionId) {
                this.showAlert('error', 'Invalid inspection ID');
                return;
            }

            // Show loading state
            const uploadBtn = $('#uploadInspectionFileBtn');
            const originalText = uploadBtn.html();
            uploadBtn.html('<i class="fas fa-spinner fa-spin"></i> Uploading...').prop('disabled', true);

            formData.append('file', fileInput.files[0]);
            formData.append('inspectionId', inspectionId);
            formData.append('description', description);

            $.ajax({
                url: '/IntranetPortal/InspectionPwa/UploadInspectionFile',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: (result) => {
                    if (result.isSuccess) {
                        this.showAlert('success', 'File uploaded successfully');
                        $('#inspectionFileUploadModal').modal('hide');
                        this.loadMyInspections(); // Refresh the list
                    } else {
                        this.showAlert('error', result.errMsg || 'Upload failed');
                    }
                },
                error: () => {
                    this.showAlert('error', 'Error uploading file');
                },
                complete: () => {
                    uploadBtn.html(originalText).prop('disabled', false);
                }
            });
        }

        showCompleteInspectionModal(inspectionId) {
            $('#completeInspectionId').val(inspectionId);
            $('#inspectionFindings').val('');
            $('#inspectionRecommendations').val('');
            $('#completeInspectionModal').modal('show');
        }

        completeInspection() {
            const inspectionId = $('#completeInspectionId').val();
            const findings = $('#inspectionFindings').val().trim();
            const recommendations = $('#inspectionRecommendations').val().trim();

            if (!findings) {
                this.showAlert('error', 'Please enter inspection findings');
                return;
            }

            const completeBtn = $('#completeInspectionBtn');
            const originalText = completeBtn.html();
            completeBtn.html('<i class="fas fa-spinner fa-spin"></i> Completing...').prop('disabled', true);

            $.ajax({
                url: '/IntranetPortal/InspectionPwa/CompleteInspection',
                type: 'POST',
                data: JSON.stringify({
                    inspectionId: inspectionId,
                    findings: findings,
                    recommendations: recommendations
                }),
                contentType: 'application/json',
                success: (result) => {
                    if (result.isSuccess) {
                        this.showAlert('success', 'Inspection completed successfully');
                        $('#completeInspectionModal').modal('hide');
                        this.loadMyInspections(); // Refresh the list
                    } else {
                        this.showAlert('error', result.errMsg || 'Failed to complete inspection');
                    }
                },
                error: () => {
                    this.showAlert('error', 'Error completing inspection');
                },
                complete: () => {
                    completeBtn.html(originalText).prop('disabled', false);
                }
            });
        }

        viewInspectionFiles(inspectionId) {
            $.get('/IntranetPortal/InspectionPwa/GetInspectionFiles', { inspectionId: inspectionId })
                .done((result) => {
                    if (result.isSuccess) {
                        this.displayInspectionFiles(result.data);
                        $('#viewInspectionFilesModal').modal('show');
                    } else {
                        this.showAlert('error', result.errMsg || 'Error loading files');
                    }
                })
                .fail(() => {
                    this.showAlert('error', 'Error loading inspection files');
                });
        }

        displayInspectionFiles(files) {
            const content = $('#inspectionFilesContent');
            content.empty();

            if (files && files.length > 0) {
                let filesList = '<div class="list-group">';

                files.forEach((file) => {
                    const uploadDate = new Date(file.createdOn).toLocaleDateString();
                    filesList += `
                        <div class="list-group-item">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="flex-grow-1">
                                    <h6 class="mb-1">${file.originalFileName}</h6>
                                    <small class="text-muted">Uploaded: ${uploadDate}</small>
                                    ${file.description ? `<br><small class="text-info">${file.description}</small>` : ''}
                                </div>
                                <div class="btn-group-vertical btn-group-sm">
                                    <a href="/IntranetPortal/InspectionPwa/DownloadInspectionFile?fileId=${file.id}"
                                       class="btn btn-outline-primary btn-sm">
                                        <i class="fas fa-download"></i> Download
                                    </a>
                                    <button type="button" class="btn btn-outline-danger btn-sm"
                                            onclick="inspectionFileManager.deleteInspectionFile('${file.id}')">
                                        <i class="fas fa-trash"></i> Delete
                                    </button>
                                </div>
                            </div>
                        </div>
                    `;
                });

                filesList += '</div>';
                content.html(filesList);
            } else {
                content.html(`
                    <div class="text-center p-4">
                        <i class="fas fa-file-alt fa-3x text-muted mb-3"></i>
                        <p class="text-muted">No files uploaded for this inspection yet</p>
                    </div>
                `);
            }
        }

        deleteInspectionFile(fileId) {
            if (confirm('Are you sure you want to delete this file?')) {
                $.ajax({
                    url: `/IntranetPortal/InspectionPwa/DeleteInspectionFile/${fileId}`,
                    type: 'DELETE',
                    success: (result) => {
                        if (result.isSuccess) {
                            this.showAlert('success', 'File deleted successfully');
                            // Refresh files if modal is open
                            if ($('#viewInspectionFilesModal').hasClass('show')) {
                                const inspectionId = $('#uploadInspectionId').val();
                                if (inspectionId) {
                                    this.viewInspectionFiles(inspectionId);
                                }
                            }
                            this.loadMyInspections();
                        } else {
                            this.showAlert('error', result.errMsg || 'Failed to delete file');
                        }
                    },
                    error: () => {
                        this.showAlert('error', 'Error deleting file');
                    }
                });
            }
        }

        loadMyInspections() {
            $.get('/IntranetPortal/InspectionPwa/GetMyAssignedInspections')
                .done((result) => {
                    if (result.isSuccess) {
                        this.displayInspectionsList(result.data);
                    } else {
                        this.showAlert('error', result.errMsg || 'Error loading inspections');
                    }
                })
                .fail(() => {
                    this.showAlert('error', 'Error loading your inspections');
                });
        }

        displayInspectionsList(inspections) {
            // This would be implemented based on where you want to display the inspections list
            // Could be in a sidebar, main content area, etc.
            console.log('Loaded inspections:', inspections);
        }

        showAlert(type, message) {
            // Use your existing notification system or create a simple one
            if (typeof notifyAlerts === 'function') {
                notifyAlerts(type, message);
            } else {
                // Fallback alert
                const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
                const alertHtml = `
                    <div class="alert ${alertClass} alert-dismissible fade show" role="alert">
                        ${message}
                        <button type="button" class="close" data-dismiss="alert">
                            <span>&times;</span>
                        </button>
                    </div>
                `;

                // Append to body or a specific container
                $('body').prepend(alertHtml);

                // Auto-hide after 5 seconds
                setTimeout(() => {
                    $('.alert').fadeOut();
                }, 5000);
            }
        }
    }

    // Initialize when document is ready
    $(document).ready(() => {
        window.inspectionFileManager = new InspectionFileManager();
    });
</script>