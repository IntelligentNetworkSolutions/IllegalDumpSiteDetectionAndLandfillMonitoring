@using MainApp.MVC.Filters;
@using MainApp.MVC.Helpers;
<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>@ViewData["Title"] - Waste Detection PWA</title>
    <link rel="icon" type="image/x-icon" href="~/logo.png" asp-append-version="true">

    <!-- Essential CSS -->
    <link rel="stylesheet" href="~/vendor/typeface-source-sans-pro/index.css">
    <link rel="stylesheet" href="~/vendor/admin-lte/plugins/fontawesome-free/css/all.min.css">
    <link rel="stylesheet" href="~/vendor/font-gis/css/font-gis.css">
    <link rel="stylesheet" href="~/vendor/admin-lte/plugins/icheck-bootstrap/icheck-bootstrap.min.css">
    <link rel="stylesheet" href="~/vendor/admin-lte/plugins/jquery-ui/jquery-ui.css">
    <link rel="stylesheet" href="~/vendor/admin-lte/plugins/select2/css/select2.min.css">
    <link rel="stylesheet" href="~/vendor/admin-lte/plugins/select2-bootstrap4-theme/select2-bootstrap4.min.css">
    <link rel="stylesheet" href="~/vendor/admin-lte/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="~/vendor/admin-lte/plugins/datatables-responsive/css/responsive.bootstrap4.min.css">
    <link rel="stylesheet" href="~/vendor/admin-lte/plugins/datatables-buttons/css/buttons.bootstrap4.min.css">
    <link rel="stylesheet" href="~/vendor/admin-lte/plugins/daterangepicker/daterangepicker.css">
    <link rel="stylesheet" href="~/vendor/admin-lte/plugins/tempusdominus-bootstrap-4/css/tempusdominus-bootstrap-4.min.css">
    <link rel="stylesheet" href="~/vendor/admin-lte/dist/css/adminlte.css">
    <link rel="stylesheet" href="~/vendor/admin-lte/plugins/sweetalert2-theme-bootstrap-4/bootstrap-4.min.css">
    <link rel="stylesheet" href="~/vendor//cropperjs/dist/cropper.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/vendor/paginationjs/dist/pagination.css" />
    <link rel="stylesheet" href="~/vendor/admin-lte/plugins/ion-rangeslider/css/ion.rangeSlider.min.css">
    <link rel="stylesheet" href="~/css/sidebar.css">
    <link rel="stylesheet" href="~/InspectionPwa/css/styles.css">

    <!-- PWA Manifest -->
    <link rel="manifest" href="/MainApp/IntranetPortal/InspectionPwa/ManifestJson">

    <!-- Essential PWA Meta Tags -->
    <meta name="theme-color" content="#28a745">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="WasteDetection">
    <meta name="application-name" content="WasteDetection">
    <meta name="msapplication-TileColor" content="#28a745">

    <!-- Icons -->
    <link rel="icon" type="image/png" sizes="32x32" href="/InspectionPwa/images/icons/icon-128x128.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/InspectionPwa/images/icons/icon-192x192.png">
    <link rel="apple-touch-icon" sizes="192x192" href="/InspectionPwa/images/icons/icon-192x192.png">

    @if (IsSectionDefined("Styles"))
    {
        @RenderSection("Styles", required: false)
    }
</head>
<body class="pwa-layout">
    <!-- Essential Scripts -->
    <script src="~/InspectionPwa/js/app.js"></script>
    <script src="~/vendor/admin-lte/plugins/jquery/jquery.min.js"></script>
    <script src="~/vendor/admin-lte/plugins/jquery-ui/jquery-ui.js"></script>
    <script src="~/vendor/admin-lte/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/tempus-dominus-helper.js"></script>
    <script src="~/vendor/admin-lte/plugins/select2/js/select2.full.min.js"></script>
    <script src="~/vendor/admin-lte/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="~/vendor/admin-lte/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/vendor/admin-lte/plugins/datatables-responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/vendor/admin-lte/plugins/datatables-responsive/js/responsive.bootstrap4.min.js"></script>
    <script src="~/vendor/admin-lte/plugins/datatables-buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/vendor/admin-lte/plugins/datatables-buttons/js/buttons.bootstrap4.min.js"></script>
    <script src="~/vendor/admin-lte/plugins/jszip/jszip.min.js"></script>
    <script src="~/vendor/admin-lte/plugins/pdfmake/pdfmake.min.js"></script>
    <script src="~/vendor/admin-lte/plugins/pdfmake/vfs_fonts.js"></script>
    <script src="~/vendor/admin-lte/plugins/datatables-buttons/js/buttons.html5.min.js"></script>
    <script src="~/vendor/admin-lte/plugins/datatables-buttons/js/buttons.print.min.js"></script>
    <script src="~/vendor/admin-lte/plugins/datatables-buttons/js/buttons.colVis.min.js"></script>
    <script src="~/vendor/admin-lte/plugins/sweetalert2/sweetalert2.min.js"></script>
    <script src="~/vendor/admin-lte/plugins/moment/moment.min.js"></script>
    <script src="~/vendor/admin-lte/plugins/daterangepicker/daterangepicker.js"></script>
    <script src="~/vendor/admin-lte/plugins/tempusdominus-bootstrap-4/js/tempusdominus-bootstrap-4.min.js"></script>
    <script src="~/vendor/admin-lte/dist/js/adminlte.min.js"></script>
    <script src="~/vendor/cropperjs/dist/cropper.min.js"></script>
    <script src="~/vendor/paginationjs/dist/pagination.min.js"></script>
    <script src="~/vendor/geotiff/dist-browser/geotiff.js"></script>
    <script src="~/vendor/admin-lte/plugins/ion-rangeslider/js/ion.rangeSlider.min.js"></script>
    <script src="~/vendor/admin-lte/plugins/chart.js/Chart.min.js"></script>
    <script src="~/js/notification-helpers.js"></script>
    <script src="~/js/site.js"></script>

    <!-- PWA Navbar -->
    <nav class="pwa-navbar navbar navbar-expand navbar-dark">
        <a href="#" class="navbar-brand">
            <img src="~/logo.png" alt="Logo" class="brand-image" style="opacity: .8; height: 32px; width: 32px; margin-right: 8px;">
            Waste Detection
        </a>

        <ul class="navbar-nav ml-auto">
            <li class="nav-item">
                <a class="nav-link" href="#" onclick="showMyInspections()">
                    <i class="fas fa-tasks"></i>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="IntranetPortal" asp-controller="Account" asp-action="MyProfile">
                    <i class="fas fa-user-edit"></i>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="IntranetPortal" asp-controller="Account" asp-action="Logout">
                    <i class="fas fa-sign-out-alt"></i>
                </a>
            </li>
        </ul>
    </nav>

    <!-- Main Content -->
    <div class="pwa-content">
        @RenderBody()
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>