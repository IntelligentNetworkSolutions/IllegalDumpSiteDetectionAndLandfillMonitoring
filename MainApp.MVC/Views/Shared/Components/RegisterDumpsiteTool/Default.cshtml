            }
        });
    }

        function cleanGeometry(geometry) {
        try {
            // For polygons, ensure they don't have self-intersections
            if (geometry instanceof ol.geom.Polygon) {
                var coordinates = geometry.getCoordinates();
                var ring = coordinates[0];

                // Remove duplicate consecutive points
                var cleanedRing = [];
                for (var i = 0; i < ring.length; i++) {
                    if (i === 0 ||
                        ring[i][0] !== ring[i-1][0] ||
                        ring[i][1] !== ring[i-1][1]) {
                        cleanedRing.push(ring[i]);
                    }
                }

                // Ensure ring is closed
                if (cleanedRing.length > 3 &&
                    (cleanedRing[0][0] !== cleanedRing[cleanedRing.length-1][0] ||
                     cleanedRing[0][1] !== cleanedRing[cleanedRing.length-1][1])) {
                    cleanedRing.push(cleanedRing[0]);
                }

                if (cleanedRing.length >= 4) {
                    return new ol.geom.Polygon([cleanedRing]);
                }
            }

            return geometry;
        } catch (e) {
            console.warn('Geometry cleaning failed:', e);
            return geometry;
        }
    }
