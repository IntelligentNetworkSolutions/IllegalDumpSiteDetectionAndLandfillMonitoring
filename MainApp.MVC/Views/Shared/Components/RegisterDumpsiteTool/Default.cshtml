    //BTNS CLICKS FUNCTIONS
    //1.edit dumpsite btn click functions
    let modifyInteraction;
    let originalGeometry;

    function editDumpsite(dumpsiteId) {
        var originalZIndex = $('#map-sidebar').css('z-index');
        Swal.fire({
            text: '@DbResHtml.T("Do you want to edit the selected registered dumpsite?", "Resources")',
            showDenyButton: true,
            showCancelButton: true,
            allowOutsideClick: false,
            confirmButtonText: '@DbResHtml.T("Yes", "Resources")',
            denyButtonText: '@DbResHtml.T("No, just other properties", "Resources")',
            cancelButtonText: '@DbResHtml.T("Cancel", "Resources")',
            customClass: {
                confirmButton: 'bg-gradient-success',
                cancelButton: 'bg-gradient-secondary',
                denyButton: 'bg-gradient-dark'
            },
            didOpen: () => {
                manageMapSidebarZIndex(originalZIndex, '1040');
            },
            willClose: () => {
                manageMapSidebarZIndex(originalZIndex, '1040');
            },
            icon: "warning"
        }).then((result) => {
            if (result.isConfirmed) {
                var dumpsiteToEdit = getDumpsiteById(dumpsiteId);
                if (!dumpsiteToEdit) {
                    Swal.fire({
                        text: '@DbResHtml.T("Selected dumpsite not found", "Resources")',
                        confirmButtonText: '@DbResHtml.T("Ok", "Resources")',
                        allowOutsideClick: false,
                        icon: "error"
                    });
                    return;
                }

                focusOnSelectedDumpsite(dumpsiteToEdit);
                enableEditDumpsiteMode(dumpsiteToEdit, dumpsiteId);
            }
            else if (result.isDenied) {
                var dumpsiteToEdit = getDumpsiteById(dumpsiteId);
                if (!dumpsiteToEdit) {
                    Swal.fire({
                        text: '@DbResHtml.T("Selected dumpsite not found", "Resources")',
                        confirmButtonText: '@DbResHtml.T("Ok", "Resources")',
                        allowOutsideClick: false,
                        icon: "error"
                    });
                    return;
                }

                openEditDumpsiteModal(null, dumpsiteId, false);
            }
        });
    }

    function getDumpsiteById(dumpsiteId) {
        var dumpsitesLayer = mapVars.map.getLayers().getArray().find(layer =>
            layer instanceof ol.layer.Vector && layer.get('title') === 'Registered Dumpsites'
        );

        var features = dumpsitesLayer.getSource().getFeatures();
        var selectedDumpsite = features.find(function (feature) {
            return feature.get('id') === dumpsiteId;
        });
        return selectedDumpsite;
    }

    function focusOnSelectedDumpsite(dumpsite) {
        var originalZIndex = $('#map-sidebar').css('z-index');
        var extent = dumpsite.getGeometry().getExtent();

        if (extent[0] === Infinity && extent[1] === Infinity && extent[2] === -Infinity && extent[3] === -Infinity)
        {
            Swal.fire({
                text: '@DbResHtml.T("Invalid extent for the layer", "Resources")',
                confirmButtonText: '@DbResHtml.T("Ok", "Resources")',
                didOpen: () => {
                    manageMapSidebarZIndex(originalZIndex, '1040');
                },
                willClose: () => {
                    manageMapSidebarZIndex(originalZIndex, '1040');
                },
                allowOutsideClick: false,
                icon: "error"
            });
            return;
        }

        var padding = [50, 50, 50, 50];
        mapVars.map.getView().fit(extent, {
            padding: padding,
            duration: 1000
        });
    }

    function enableEditDumpsiteMode(dumpsite, dumpsiteId) {
        cleanUpEditDumpsiteMode();
        originalGeometry = dumpsite.getGeometry().clone();

        if (currentFocusedPolygon === null) {
            currentFocusedPolygon = dumpsite;
            let dumpsiteName = dumpsite.get('dumpsiteName');
            dumpsite.setStyle(createFocusedStyle(dumpsiteName));
        }

        if (currentFocusedPolygon !== dumpsite) {
            let dumpsiteName = currentFocusedPolygon.get('dumpsiteName');
            let dumpsiteIsEnabled = currentFocusedPolygon.get('isEnabled');
            currentFocusedPolygon.setStyle(defaultStyle(dumpsiteName, dumpsiteIsEnabled));
            currentFocusedPolygon = dumpsite;
        }

        modifyInteraction = new ol.interaction.Modify({
            features: new ol.Collection([dumpsite])
        });
        mapVars.map.addInteraction(modifyInteraction);

        let dumpsiteName = dumpsite.get('dumpsiteName');
        dumpsite.setStyle(createFocusedStyle(dumpsiteName));

        $("#editNotify").removeClass("d-none").fadeIn(300);
        $("#finishEditingButton").off('click').on('click', function () {
            handleFinishEditingButtonClick(dumpsite, dumpsiteId);
        });
        $("#cancelEditingButton").off('click').on('click', function () {
            handleCancelEditingButtonClick(dumpsite);
        });
    }

    function handleCancelEditingButtonClick(dumpsite) {
        let dumpsiteName = dumpsite.get('dumpsiteName');
        let dumpsiteIsEnabled = dumpsite.get('isEnabled');
        if (dumpsite && originalGeometry) {
            dumpsite.setGeometry(originalGeometry.clone());
        }
        if (dumpsite) {
            dumpsite.setStyle(defaultStyle(dumpsiteName, dumpsiteIsEnabled));
        }
        cleanUpEditDumpsiteMode();

        $("#editNotify").fadeOut(300, function () {
            $(this).addClass("d-none");
        });
        currentFocusedPolygon = null;
    }

    function handleFinishEditingButtonClick(dumpsite, dumpsiteId) {
        // Check for overlaps with the modified geometry
        var overlaps = checkForOverlaps(dumpsite);
        overlaps = overlaps.filter(overlap => overlap.id !== dumpsiteId); // Remove self from overlaps

        cleanUpEditDumpsiteMode();
        $("#editNotify").fadeOut(300, function () {
            $(this).addClass("d-none");
        });

        var geoJsonFormat = new ol.format.GeoJSON();
        var finalGeoJson = geoJsonFormat.writeFeature(dumpsite);

        if (overlaps.length > 0) {
            // Handle overlaps during editing
            handleEditOverlaps(finalGeoJson, dumpsiteId, overlaps);
        } else {
            openEditDumpsiteModal(finalGeoJson, dumpsiteId, true);
        }
    }

    function handleEditOverlaps(geoJson, dumpsiteId, overlaps) {
        var originalZIndex = $('#map-sidebar').css('z-index');

        Swal.fire({
            title: '@DbResHtml.T("Overlap Detected During Edit", "Resources")',
            text: '@DbResHtml.T("The modified dumpsite overlaps with existing dumpsites. How would you like to proceed?", "Resources")',
            showDenyButton: true,
            showCancelButton: true,
            confirmButtonText: '@DbResHtml.T("Continue Edit", "Resources")',
            denyButtonText: '@DbResHtml.T("Merge with Overlaps", "Resources")',
            cancelButtonText: '@DbResHtml.T("Cancel", "Resources")',
            customClass: {
                confirmButton: 'bg-gradient-warning',
                denyButton: 'bg-gradient-primary',
                cancelButton: 'bg-gradient-secondary'
            },
            didOpen: () => {
                manageMapSidebarZIndex(originalZIndex, '1040');
            },
            willClose: () => {
                manageMapSidebarZIndex(originalZIndex, '1040');
            },
            icon: "warning"
        }).then((result) => {
            if (result.isConfirmed) {
                // Continue with normal edit
                openEditDumpsiteModal(geoJson, dumpsiteId, true);
            } else if (result.isDenied) {
                // Merge with overlapping dumpsites
                performEditMerge(geoJson, dumpsiteId, overlaps);
            } else {
                // Cancel - restore original geometry
                handleCancelEditingButtonClick(currentFocusedPolygon);
            }
        });
    }

    function performEditMerge(geoJson, targetId, overlaps) {
        var idsToMerge = overlaps.map(overlap => overlap.id);

        // Get the target dumpsite data
        var targetDumpsite = getDumpsiteById(targetId);
        if (!targetDumpsite) {
            Swal.fire({
                text: '@DbResHtml.T("Target dumpsite not found", "Resources")',
                confirmButtonText: '@DbResHtml.T("Ok", "Resources")',
                icon: "error"
            });
            return;
        }

        // Call server-side merge operation
        $.ajax({
            type: "POST",
            url: "@Url.Action("MergeRegisteredDumpsites", "RegisteredDumpsites", new { Area = "IntranetPortal" })",
            data: JSON.stringify({
                NewDumpsiteData: {
                    Name: targetDumpsite.get('dumpsiteName'),
                    Description: targetDumpsite.get('description') || '',
                    EnteredZonePolygon: geoJson,
                    IsEnabled: targetDumpsite.get('isEnabled')
                },
                ExistingDumpsiteIds: idsToMerge
            }),
            contentType: "application/json",
            success: function(data) {
                if (data.isSuccess) {
                    refreshDumpsitesView();
                    Swal.fire({
                        text: '@DbResHtml.T("Dumpsites merged successfully", "Resources")',
                        confirmButtonText: '@DbResHtml.T("Ok", "Resources")',
                        icon: "success"
                    });
                } else {
                    Swal.fire({
                        text: data.errMsg,
                        confirmButtonText: '@DbResHtml.T("Ok", "Resources")',
                        icon: "error"
                    });
                }
            },
            error: function() {
                Swal.fire({
                    text: '@DbResHtml.T("Error occurred during merge operation", "Resources")',
                    confirmButtonText: '@DbResHtml.T("Ok", "Resources")',
                    icon: "error"
                });
            }
        });
    }

