    function saveEditDumpsite() {
     var originalZIndex = $('#map-sidebar').css('z-index');
     var id = $("#editDumpsiteId").val();
     var name = $("#editDumpsiteName").val();
     var description = $("#editDumpsiteDescription").val();
     var wasteTypeId = $("#editDumpsiteWasteType").val();
     var riskLevelId = $("#editDumpsiteRiskLevel").val();
     var isEnabled = $("#isEditDumpsiteEnabled").prop("checked");

     // Validation
     if (name.trim() === "") {
         showValidationError('@DbResHtml.T("Name is required", "Resources")', originalZIndex);
         return;
     }

     if (!wasteTypeId || wasteTypeId.trim() === "") {
         showValidationError('@DbResHtml.T("Waste Type is required", "Resources")', originalZIndex);
         return;
     }

     if (!riskLevelId || riskLevelId.trim() === "") {
         showValidationError('@DbResHtml.T("Risk Level is required", "Resources")', originalZIndex);
         return;
     }

     // Continue with existing save logic...
     var formattedGeoJson = null;
     if ($("#editDumpsiteModal").data("useGeoJson")) {
         var geoJsonString = $("#editedPolygonCoordinates").val();
         var geoJsonObject = JSON.parse(geoJsonString);
         var geoJsonFormat = new ol.format.GeoJSON();
         var feature = geoJsonFormat.readFeature(geoJsonObject);
         formattedGeoJson = geoJsonFormat.writeFeature(feature);
     }
        $.ajax({
            type: "POST",
            url: "@Url.Action("UpdateRegisteredDumpsite", "RegisteredDumpsites", new { Area = "IntranetPortal" })",
            data: JSON.stringify({
                Id: id,
                Name: name,
                Description: description,
                RegisteredDumpsiteWasteTypeId: wasteTypeId || null,
                RegisteredDumpsiteRiskLevelId: riskLevelId || null,
                EnteredZonePolygon: formattedGeoJson,
                IsEnabled: isEnabled
            }),
            contentType: "application/json",
            success: function (data) {
                $("#editDumpsiteModal").modal('hide');
                if (data != undefined || data != null) {
                    if (data.isSuccess == false && data.errMsg != null) {
                        Swal.fire({
                            text: `${data.errMsg}`,
                            confirmButtonText: '@DbResHtml.T("Ok", "Resources")',
                            didOpen: () => {
                                manageMapSidebarZIndex(originalZIndex, '1040');
                            },
                            willClose: () => {
                                manageMapSidebarZIndex(originalZIndex, '1040');
                            },
                            allowOutsideClick: false,
                            icon: "error"
                        });
                    }
                    else {
                        Swal.fire({
                            text: '@DbResHtml.T("Registered dumpsite updated successfully", "Resources")',
                            confirmButtonText: '@DbResHtml.T("Ok", "Resources")',
                            didOpen: () => {
                                manageMapSidebarZIndex(originalZIndex, '1040');
                            },
                            willClose: () => {
                                manageMapSidebarZIndex(originalZIndex, '1040');
                            },
                            allowOutsideClick: false,
                            icon: "success"
                        }).then((result) => {
                            if (result.isConfirmed) {
                                resetEditModalInputValues();
                                getAllRegisteredDumpsites();
                                generateRegisteredDumpsitesTable();
                            }
                        });

                    }
                }
                else {
                    Swal.fire({
                        text: `@DbResHtml.T("No data received", "Resources")`,
                        confirmButtonText: '@DbResHtml.T("Ok", "Resources")',
                        didOpen: () => {
                            manageMapSidebarZIndex(originalZIndex, '1040');
                        },
                        willClose: () => {
                            manageMapSidebarZIndex(originalZIndex, '1040');
                        },
                        allowOutsideClick: false,
                        icon: "error"
                    });
                }
            },
            error: function () {
                $("#editDumpsiteModal").modal('hide');
                Swal.fire({
                    text: '@DbResHtml.T("Error occurred while saving", "Resources")',
                    confirmButtonText: '@DbResHtml.T("Ok", "Resources")',
                    didOpen: () => {
                        manageMapSidebarZIndex(originalZIndex, '1040');
                    },
                    willClose: () => {
                        manageMapSidebarZIndex(originalZIndex, '1040');
                    },
                    allowOutsideClick: false,
                    icon: "error"
                });
            }
        });
    }

