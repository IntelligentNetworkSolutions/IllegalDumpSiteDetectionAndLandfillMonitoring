@model Guid?
@using DTOs.MainApp.BL.RegisteredDumpsiteDTOs;
@using MainApp.MVC.Helpers;
@using Westwind.Globalization
@using Westwind.Globalization.AspNetCore.Extensions
@using Westwind.Globalization.AspNetCore
@using Newtonsoft.Json


<!-- Modal HTML -->
<div class="modal fade" id="polygonModal" tabindex="-1" role="dialog" aria-labelledby="polygonModalLabel" aria-hidden="true" style="z-index:2000;">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="polygonModalLabel">@DbResHtml.T("Proceed adding new registered dumpsite", "Resources")</h5>
            </div>
            <div class="modal-body">
                <form id="polygonForm">
                    <div class="form-group">
                        <label for="dumpsiteName">@DbResHtml.T("Name", "Resources")</label>
                        <input type="text" class="form-control" id="dumpsiteName" required>
                    </div>
                    <div class="form-group">
                        <label for="dumpsiteDescription">@DbResHtml.T("Description", "Resources")</label>
                        <input type="text" class="form-control" id="dumpsiteDescription" required>
                    </div>
                    <div class="form-group">
                        <label for="dumpsiteWasteType">@DbResHtml.T("Waste Type", "Resources")</label>
                        <select class="form-control select2" id="dumpsiteWasteType" style="width: 100%;">
                            <option value="">@DbResHtml.T("Select Waste Type", "Resources")</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="dumpsiteRiskLevel">@DbResHtml.T("Risk Level", "Resources")</label>
                        <select class="form-control select2" id="dumpsiteRiskLevel" style="width: 100%;">
                            <option value="">@DbResHtml.T("Select Risk Level", "Resources")</option>
                        </select>
                    </div>
                    <div class="form-group clearfix">
                        <div class="icheck-success mt-3 text-bold">
                            <input type="checkbox" id="isDumpsiteEnabled" />
                            <label for="isDumpsiteEnabled">
                                @DbResHtml.T("Is Enabled", "Resources")
                            </label>
                        </div>
                    </div>
                    <input type="hidden" id="polygonCoordinates">
                </form>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-dismiss="modal" onclick="closeAddPolygonModal()">@DbResHtml.T("Cancel", "Resources")</button>
                <button type="button" class="btn btn-sm bg-gradient-success" onclick="savePolygon()">@DbResHtml.T("Save", "Resources")</button>
            </div>
        </div>
    </div>
</div>

<!-- Overlap Resolution Modal -->
<div class="modal fade" id="overlapModal" tabindex="-1" role="dialog" aria-labelledby="overlapModalLabel" aria-hidden="true" style="z-index:2100;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="overlapModalLabel">@DbResHtml.T("Dumpsite Overlap Detected", "Resources")</h5>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle"></i>
                    @DbResHtml.T("The new dumpsite overlaps with existing dumpsites. Please choose how to proceed:", "Resources")
                </div>
                <div id="overlapDetails" class="mb-3">
                    <!-- Overlapping dumpsites will be listed here -->
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="card border-primary">
                            <div class="card-body text-center">
                                <i class="fas fa-object-group fa-2x text-primary mb-2"></i>
                                <h6>@DbResHtml.T("Merge", "Resources")</h6>
                                <p class="small">@DbResHtml.T("Combine all overlapping dumpsites into one", "Resources")</p>
                                <button type="button" class="btn btn-primary btn-sm" onclick="resolveOverlap('merge')">
                                    @DbResHtml.T("Merge Dumpsites", "Resources")
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card border-success">
                            <div class="card-body text-center">
                                <i class="fas fa-save fa-2x text-success mb-2"></i>
                                <h6>@DbResHtml.T("Retain", "Resources")</h6>
                                <p class="small">@DbResHtml.T("Keep existing shapes and add new dumpsite", "Resources")</p>
                                <button type="button" class="btn btn-success btn-sm" onclick="resolveOverlap('retain')">
                                    @DbResHtml.T("Keep All", "Resources")
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="cancelOverlapResolution()">@DbResHtml.T("Cancel", "Resources")</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editDumpsiteModal" tabindex="-1" role="dialog" aria-labelledby="editDumpsiteModalLabel" aria-hidden="true" style="z-index:2000;">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editDumpsiteModalLabel">@DbResHtml.T("Proceed editing the selected registered dumpsite", "Resources")</h5>
            </div>
            <div id="editDumpsiteModalBody" class="modal-body">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-dismiss="modal" onclick="closeEditDumpsiteModal()">@DbResHtml.T("Cancel", "Resources")</button>
                <button type="button" class="btn btn-sm bg-gradient-warning text-white" onclick="saveEditDumpsite()">@DbResHtml.T("Save", "Resources")</button>
            </div>
        </div>
    </div>
</div>

<!-- edit polygon alert-->
<div id="editNotify" class="d-none position-fixed bg-gradient-dark text-white p-3 rounded shadow-lg" style="top: 60px; left: 50%; transform: translateX(-50%); z-index: 1000; opacity: 0.95;">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <span class="lead">@DbResHtml.T("Editing Registered Dumpsite", "Resources")</span>
        <button id="finishEditingButton" class="btn btn-xs btn-warning ml-4">@DbResHtml.T("Proceed", "Resources")</button>
        <button id="cancelEditingButton" class="btn btn-xs btn-outline-light mx-2">@DbResHtml.T("Cancel", "Resources")</button>
    </div>
    <div>
        <p class="mb-0 text-xs">@DbResHtml.T("CLICK AND HOLD on the polygon lines to start editing.", "Resources")</p>
        <p class="mb-0 text-xs">@DbResHtml.T("Click PROCEED to continue.", "Resources")</p>
        <p class="mb-0 text-xs">@DbResHtml.T("Click CANCEL or ESC to abort editing.", "Resources")</p>
    </div>
</div>

<div id="addNotify" class="d-none position-fixed bg-gradient-dark text-white p-3 rounded shadow-lg" style="top: 60px; left: 50%; transform: translateX(-50%); z-index: 1000; opacity: 0.95;">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <span class="lead">@DbResHtml.T("Adding Registered Dumpsite", "Resources")</span>
        <button id="cancelAddingDumpsiteBtn" class="btn btn-sm btn-outline-light">@DbResHtml.T("Cancel", "Resources")</button>
    </div>
    <div>
        <p class="mb-0 text-xs">@DbResHtml.T("CLICK on the map to start drawing.", "Resources")</p>
        <p class="mb-0 text-xs">@DbResHtml.T("DOUBLE CLICK on the last point to finish drawing.", "Resources")</p>
        <p class="mb-0 text-xs">@DbResHtml.T("Click CANCEL or ESC to abort drawing.", "Resources")</p>
    </div>
</div>

<script type="text/javascript">
    $(function () {
        // Activate the registered dumpsites tool
        function activateRegisteredDumpsitesTool() {
            mapVars.deactivateTools();
            $("#map-sidebar-registereddumpsites-pane").addClass("active");
            this.isActive = true;
        }

        // Deactivate the registered dumpsites tool and clean up interactions
        function deactivateRegisteredDumpsitesTool() {
            cleanupDrawInteraction();
            if (currentFocusedPolygon) {
                let dumpsiteName = currentFocusedPolygon.get('dumpsiteName');
                let dumpsiteIsEnabled = currentFocusedPolygon.get('isEnabled');
                if (originalGeometry) {
                    currentFocusedPolygon.setGeometry(originalGeometry.clone());
                }
                currentFocusedPolygon.setStyle(defaultStyle(dumpsiteName, dumpsiteIsEnabled));
                currentFocusedPolygon = null;
                originalGeometry = null;
            }

            cleanUpEditDumpsiteMode();
            $('.modal').modal('hide');
            Swal.close();

            this.isActive = false;
            $("#map-sidebar-registereddumpsites-pane").removeClass("active");

            if (!$("#editNotify").hasClass("d-none")) {
                $("#editNotify").addClass("d-none");
            }

            if (!$("#addNotify").hasClass("d-none")) {
                $("#addNotify").addClass("d-none");
            }

            resetAllFeaturesToDefaultStyle();
            return true;
        }

        // Initialize the RegisteredDumpsites tool
        var registeredDumpsites = new MapToolBaseClass("RegisteredDumpsites");
        registeredDumpsites.activateTool = activateRegisteredDumpsitesTool;
        registeredDumpsites.deactivateTool = deactivateRegisteredDumpsitesTool;
        registeredDumpsites.defaultFitPadding = [30, 580, 30, 30];

        mapVars.mapTools.push(registeredDumpsites);

        // Sidebar tab and pane HTML structure
        var tabHtml = `
            <li>
                <a href="#map-sidebar-registereddumpsites-pane" id="map-sidebar-registereddumpsites-btn" role="tab" data-toggle="tooltip" data-trigger="hover" data-placement="left" title="@DbResHtml.T("Registered Dumpsites", "Resources")">
                    <i class="fas fa-dumpster"></i>
                </a>
            </li>`;

        var paneHtml = `
            <div class="turbosidebar-pane" id="map-sidebar-registereddumpsites-pane">
                 <h1 class="turbosidebar-header text-center bg-gradient-dark">
                     @DbResHtml.T("Registered Dumpsites", "Resources")
                     <span class="turbosidebar-close"><i class="fa fa-times"></i></span>
                </h1>
                <button onclick="addNewDumpsite()" class="btn btn-sm bg-gradient-success my-3" title="@DbResHtml.T("Add", "Resources")">
                    <i class="fas fa-plus"></i>&nbsp;
                     @DbResHtml.T("Add Registered Dumpsite", "Resources")
                </button>
                <div id="map-sidebar-registereddumpsitestable-tab-container"></div>
            </div>`;

        // Append the tab and pane to the sidebar
        $("#map-sidebar-upper-tabs-list").append(tabHtml);
        $("#map-sidebar-content").append(paneHtml);

        // Toggle the registered dumpsites tool when the sidebar button is clicked
        $('#map-sidebar-registereddumpsites-btn').on("click", function () {
            if ($(this).parent().hasClass("active")) {
                registeredDumpsites.deactivateTool();
            } else {
                registeredDumpsites.activateTool();
            }
        });

        // Deactivate the tool when the close button is clicked
        $(document).on("click", '#map-sidebar-registereddumpsites-pane .turbosidebar-close', function () {
            registeredDumpsites.deactivateTool();
        });

        //Deactivate the tool when other tool is clicked
        $("#map-sidebar-upper-tabs-list").on("click", "li", function (e) {
            if (!$(this).hasClass("active") && registeredDumpsites.isActive) {
                registeredDumpsites.deactivateTool();
            }
        });

        // Clean up the drawing polygon on Escape key press
        $(document).on('keydown', function (event) {
            if (event.keyCode === 27 || event.key === 'Escape') {
                cleanupDrawInteraction();
                if (!$("#addNotify").hasClass("d-none")) {
                    $("#addNotify").addClass("d-none");
                }
                if (currentFocusedPolygon) {
                    let dumpsiteName = currentFocusedPolygon.get('dumpsiteName');
                    let dumpsiteIsEnabled = currentFocusedPolygon.get('isEnabled');
                    if (originalGeometry) {
                        currentFocusedPolygon.setGeometry(originalGeometry.clone());
                    }
                    currentFocusedPolygon.setStyle(defaultStyle(dumpsiteName, dumpsiteIsEnabled));
                    currentFocusedPolygon = null;
                    originalGeometry = null;
                    cleanUpEditDumpsiteMode();
                    if (!$("#editNotify").hasClass("d-none")) {
                        $("#editNotify").addClass("d-none");
                    }
                }

            }
        });

        // Generate registered dumpsites table and fetch existing dumpsites
        generateRegisteredDumpsitesTable();
        getAllRegisteredDumpsites();
    });

    // Global variables for overlap handling
    let pendingDumpsiteData = null;
    let overlappingDumpsites = [];

    //DRAW DUMPSITE's TABLE
    function generateRegisteredDumpsitesTable() {
        var originalZIndex = $('#map-sidebar').css('z-index');
        $.ajax({
            type: "GET",
            url: "@Url.Action("GetAlllRegisteredDumpsites", "RegisteredDumpsites", new { Area = "IntranetPortal" })",
            success: function (data) {
                var registeredDumpsitesTable = "";
                if (data != undefined || data != null) {
                    if (data.isSuccess == false && data.errMsg != null) {
                        Swal.fire({
                            text: `${data.errMsg}`,
                            confirmButtonText: '@DbResHtml.T("Ok", "Resources")',
                            didOpen: () => {
                                manageMapSidebarZIndex(originalZIndex, '1040');
                            },
                            willClose: () => {
                                manageMapSidebarZIndex(originalZIndex, '1040');
                            },
                            allowOutsideClick: false,
                            icon: "error"
                        });
                    }
                    else {
                        if (data.data.length == 0) {
                            showEmptyTable(registeredDumpsitesTable)
                        }
                        else {
                            showTableOfAllRegisteredDumpsites(registeredDumpsitesTable, data.data);
                        }
                    }
                }
                else {
                    Swal.fire({
                        text: `@DbResHtml.T("No data received", "Resources")`,
                        confirmButtonText: '@DbResHtml.T("Ok", "Resources")',
                        didOpen: () => {
                            manageMapSidebarZIndex(originalZIndex, '1040');
                        },
                        willClose: () => {
                            manageMapSidebarZIndex(originalZIndex, '1040');
                        },
                        allowOutsideClick: false,
                        icon: "error"
                    });
                }
            },
            error: function (req, status, error) {
                Swal.fire({
                    text: '@DbResHtml.T("Error occured", "Resources")',
                    confirmButtonText: '@DbResHtml.T("Ok", "Resources")',
                    didOpen: () => {
                        manageMapSidebarZIndex(originalZIndex, '1040');
                    },
                    willClose: () => {
                        manageMapSidebarZIndex(originalZIndex, '1040');
                    },
                    allowOutsideClick: false,
                    icon: "error"
                });
            }
        });
    }

    function showEmptyTable(registeredDumpsitesTable) {
        registeredDumpsitesTable +=
            `   <table class='table table-striped table-bordered table-hover mt-4'>
                                            <thead>
                                                <tr>
                                                    <th>@DbResHtml.T("Name", "Resources")</th>
                                                    <th>@DbResHtml.T("Description", "Resources")</th>
                                                    <th>@DbResHtml.T("Is Enabled", "Resources")</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                   <td colspan="4" class="text-center">@DbResHtml.T("No data available.", "Resources")</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    `
        $("#map-sidebar-registereddumpsitestable-tab-container").html(registeredDumpsitesTable);
    }

    function showTableOfAllRegisteredDumpsites(registeredDumpsitesTable, dumpsitesList) {
        registeredDumpsitesTable +=
            `<table class='table table-striped table-bordered table-hover mt-4' id='registeredDumpsitesTable'>
                                        <thead>
                                            <tr>
                                                <th>@DbResHtml.T("Name", "Resources")</th>
                                                <th>@DbResHtml.T("Description", "Resources")</th>
                                                <th>@DbResHtml.T("Is Enabled", "Resources")</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                 `;

        registeredDumpsitesTable = drawTableRowsForEachDumpsite(dumpsitesList, registeredDumpsitesTable);
        registeredDumpsitesTable += `</tbody></table>`;
        $("#map-sidebar-registereddumpsitestable-tab-container").html(registeredDumpsitesTable);
    }

    function drawTableRowsForEachDumpsite(dumpsitesList, registeredDumpsitesTable) {
        dumpsitesList.forEach(function (item) {
            registeredDumpsitesTable +=
                `<tr>
                     <td style="max-width: 130px; word-wrap: break-word; white-space: normal;">${item.name}</td>
                     <td style="max-width: 130px; word-wrap: break-word; white-space: normal;">${item.description || ''}</td>
                     <td class="text-center">
                          <input type="checkbox" ${item.isEnabled ? 'checked' : ''} disabled style="transform: scale(1.5);">
                     </td>
                        <td>
                            <button onclick='focusOnDumpsite("${item.id}")' class="btn btn-xs bg-gradient-dark mr-1" title='@DbResHtml.T("Focus on this dumpsite", "Resources")'>
                                <i class="fas fa-search-location"></i>
                            </button>
                            <button onclick='editDumpsite("${item.id}")' class="btn btn-xs bg-gradient-warning text-white mx-1" title='@DbResHtml.T("Edit", "Resources")'>
                                <i class="fas fa-edit"></i>
                            </button>
                            <button onclick='deleteDumpsite("${item.id}")' class="btn btn-xs bg-gradient-danger mx-1" title='@DbResHtml.T("Delete", "Resources")'>
                                <i class="fas fa-trash"></i>
                            </button>
                            <button onclick='infoDumpsite("${item.id}")' class="btn btn-xs bg-gradient-info text-white ml-1" title='@DbResHtml.T("Info", "Resources")'>
                                <i class="fas fa-info-circle"></i>
                            </button>
                        </td>
                 </tr>
                `
        });
        return registeredDumpsitesTable;
    }

    // Overlap Detection Functions
    function checkForOverlaps(newFeature) {
        var dumpsitesLayer = mapVars.map.getLayers().getArray().find(layer =>
            layer instanceof ol.layer.Vector && layer.get('title') === 'Registered Dumpsites'
        );

        if (!dumpsitesLayer) return [];

        var overlaps = [];
        var newGeometry = newFeature.getGeometry();
        var features = dumpsitesLayer.getSource().getFeatures();

        features.forEach(function(feature) {
            var existingGeometry = feature.getGeometry();
    if (newGeometry.intersectsExtent(existingGeometry.getExtent())) {
                    overlaps.push({
                    feature: feature,
                    id: feature.get('id'),
                    name: feature.get('dumpsiteName')
                });
            }
        });

        return overlaps;
    }

    function showOverlapModal(newDumpsiteData, overlaps) {
        overlappingDumpsites = overlaps;
        pendingDumpsiteData = newDumpsiteData;

        var overlapDetails = $('#overlapDetails');
        overlapDetails.empty();

        var detailsHtml = '<h6>' + '@DbResHtml.T("Overlapping Dumpsites:", "Resources")' + '</h6>';

        // Add selection dropdown for merge target
        detailsHtml += '<div class="form-group mt-3" id="mergeTargetSelection" style="display: none;">';
        detailsHtml += '<label for="mergeTargetSelect">@DbResHtml.T("Select which dumpsite to keep as main:", "Resources")</label>';
        detailsHtml += '<select class="form-control" id="mergeTargetSelect">';
        detailsHtml += '<option value="new">@DbResHtml.T("New Dumpsite", "Resources") (' + (newDumpsiteData.name || '@DbResHtml.T("Unnamed", "Resources")') + ')</option>';
        overlaps.forEach(function(overlap) {
            detailsHtml += '<option value="' + overlap.id + '">' + overlap.name + '</option>';
        });
        detailsHtml += '</select>';
        detailsHtml += '</div>';

        detailsHtml += '<ul>';
        overlaps.forEach(function(overlap) {
            detailsHtml += '<li>' + overlap.name + '</li>';
        });
        detailsHtml += '</ul>';

        overlapDetails.html(detailsHtml);

        $('#overlapModal').modal({
            backdrop: 'static',
            keyboard: false
        });
        $('#overlapModal').modal('show');
    }


    function updateMergeButtonClick() {
        // Replace the existing onclick in your HTML with this:
        $(document).on('click', '[onclick="resolveOverlap(\'merge\')"]', function(e) {
            e.preventDefault();
            $('#mergeTargetSelection').show();
            $(this).text('@DbResHtml.T("Confirm Merge", "Resources")').attr('onclick', 'confirmMergeWithTarget()');
        });
    }

    // 3. Add new function for confirming merge with selected target
    function confirmMergeWithTarget() {
        var selectedTarget = $('#mergeTargetSelect').val();
        if (!selectedTarget) {
            alert('@DbResHtml.T("Please select a target dumpsite", "Resources")');
            return;
        }
        performMergeOperation(selectedTarget);
    }

    function resolveOverlap(action, targetId = null) {
        var originalZIndex = $('#map-sidebar').css('z-index');

        switch(action) {
            case 'merge':
                performMergeOperation();
                break;
            case 'retain':
                performRetainOperation();
                break;
        }
    }
    function performMergeOperation(targetId = null) {
        var originalZIndex = $('#map-sidebar').css('z-index');

        // Get all overlapping dumpsite IDs
        var idsToMerge = overlappingDumpsites.map(function(overlap) {
            return overlap.id;
        });

        // Determine merge data based on selected target
        var mergeData;
        var idsToDelete = [];

        if (targetId === 'new' || !targetId) {
            // Use new dumpsite data, delete all existing overlaps
            var geoJsonFormat = new ol.format.GeoJSON();
            var feature = new ol.Feature({ geometry: pendingDumpsiteData.geometry });
            var newDumpsiteGeoJson = geoJsonFormat.writeFeature(feature);

            mergeData = {
                Name: pendingDumpsiteData.name || "New Dumpsite",
                Description: pendingDumpsiteData.description || "",
                RegisteredDumpsiteWasteTypeId: pendingDumpsiteData.wasteTypeId || null,
                RegisteredDumpsiteRiskLevelId: pendingDumpsiteData.riskLevelId || null,
                EnteredZonePolygon: newDumpsiteGeoJson,
                IsEnabled: pendingDumpsiteData.isEnabled || false
            };
            idsToDelete = idsToMerge;
        } else {
            // Use existing dumpsite as base, delete others
            var targetDumpsite = overlappingDumpsites.find(o => o.id === targetId);
            if (!targetDumpsite) {
                Swal.fire({
                    text: '@DbResHtml.T("Target dumpsite not found", "Resources")',
                    icon: "error"
                });
                return;
            }

            // Get target feature and create a simple merged geometry (use the larger extent)
            var targetFeature = targetDumpsite.feature;
            var geoJsonFormat = new ol.format.GeoJSON();

            // Create a buffered version of the geometry to avoid topology issues
            var targetGeom = targetFeature.getGeometry();
            var newGeom = pendingDumpsiteData.geometry;

            // Use the new geometry as the merged result to avoid topology errors
            var newFeature = new ol.Feature({ geometry: newGeom });
            var mergedGeoJson = geoJsonFormat.writeFeature(newFeature);

            mergeData = {
                Id: targetId,
                Name: targetFeature.get('dumpsiteName'),
                Description: targetFeature.get('description') || '',
                RegisteredDumpsiteWasteTypeId: null,
                RegisteredDumpsiteRiskLevelId: null,
                EnteredZonePolygon: mergedGeoJson,
                IsEnabled: targetFeature.get('isEnabled')
            };

            // idsToDelete = idsToMerge.filter(id => id !== targetId); //kiril
            idsToDelete = idsToMerge;
        }

        // Call server-side merge operation with corrected data structure
        $.ajax({
            type: "POST",
            url: "@Url.Action("MergeRegisteredDumpsites", "RegisteredDumpsites", new { Area = "IntranetPortal" })",
            data: JSON.stringify({
                NewDumpsiteData: mergeData,  // Changed from MergeData to NewDumpsiteData
                ExistingDumpsiteIds: idsToDelete, // Changed from IdsToDelete to ExistingDumpsiteIds
                IsUpdate: targetId !== 'new' && targetId !== null
            }),
            contentType: "application/json",
            success: function(data) {
                if (data.isSuccess) {
                    closeOverlapModal();
                    resetAddModalInputValues();
                    refreshDumpsitesView();
                    Swal.fire({
                        text: '@DbResHtml.T("Dumpsites merged successfully", "Resources")',
                        confirmButtonText: '@DbResHtml.T("Ok", "Resources")',
                        didOpen: () => {
                            manageMapSidebarZIndex(originalZIndex, '1040');
                        },
                        willClose: () => {
                            manageMapSidebarZIndex(originalZIndex, '1040');
                        },
                        icon: "success"
                    });
                } else {
                    Swal.fire({
                        text: data.errMsg || '@DbResHtml.T("Merge operation failed", "Resources")',
                        confirmButtonText: '@DbResHtml.T("Ok", "Resources")',
                        didOpen: () => {
                            manageMapSidebarZIndex(originalZIndex, '1040');
                        },
                        willClose: () => {
                            manageMapSidebarZIndex(originalZIndex, '1040');
                        },
                        icon: "error"
                    });
                }
            },
            error: function(xhr, status, error) {
                console.error('Merge error:', xhr.responseText);
                Swal.fire({
                    text: '@DbResHtml.T("Error occurred during merge operation", "Resources")',
                    confirmButtonText: '@DbResHtml.T("Ok", "Resources")',
                    didOpen: () => {
                        manageMapSidebarZIndex(originalZIndex, '1040');
                    },
                    willClose: () => {
                        manageMapSidebarZIndex(originalZIndex, '1040');
                    },
                    icon: "error"
                });
            }
        });
    }

    function performRetainOperation() {
        // Simply save the new dumpsite alongside existing ones
        $('#overlapModal').modal('hide');

        var geoJsonFormat = new ol.format.GeoJSON();
        var feature = new ol.Feature({ geometry: pendingDumpsiteData.geometry });
        var geoJson = geoJsonFormat.writeFeature(feature);

        // Store the coordinates but don't open modal yet
        $("#polygonCoordinates").val(JSON.stringify(geoJson));

        // Now open the add modal
        setTimeout(function() {
            $('#polygonModal').modal({
                backdrop: 'static',
                keyboard: false
            });
            $('.modal-backdrop').css({
                'background-color': 'black',
                'opacity': '0.8',
                'z-index': '1050'
            });
            $("#polygonModal").modal('show');
        }, 300);

        pendingDumpsiteData = null;
    }

