    //2.add new registered dumpsite btn click functions
    var draw;
    var source = new ol.source.Vector({ wrapX: false });

    function addNewDumpsite() {
        var originalZIndex = $('#map-sidebar').css('z-index');
        if (!draw) {
            drawDumpsitePolygonOnMap();
        } else {
            Swal.fire({
                text: '@DbResHtml.T("Please finish the current drawing first.", "Resources")',
                confirmButtonText: '@DbResHtml.T("Ok", "Resources")',
                didOpen: () => {
                    manageMapSidebarZIndex(originalZIndex, '1040');
                },
                willClose: () => {
                    manageMapSidebarZIndex(originalZIndex, '1040');
                },
                allowOutsideClick: false,
                icon: "warning"
            });
        }
    }

    function drawDumpsitePolygonOnMap() {
        cleanupDrawInteraction();

        $("#addNotify").removeClass("d-none").fadeIn(300);
        draw = new ol.interaction.Draw({
            source: source,
            type: 'Polygon',
            style: createFocusedStyle(),
            projection: mapVars.projection
        });

        mapVars.map.addInteraction(draw);
        $("#cancelAddingDumpsiteBtn").off('click').on('click', function () {
            cancelAddingDumpsite();
        });

        draw.on('drawend', function (event) {
            // Clean the geometry before checking overlaps
            var cleanedGeometry = cleanGeometry(event.feature.getGeometry());
            event.feature.setGeometry(cleanedGeometry);

            var overlaps = checkForOverlaps(event.feature);

            cleanupDrawInteraction();
            $("#addNotify").fadeOut(300, function () {
                $(this).addClass("d-none");
            });

            if (overlaps.length > 0) {
                // Show overlap resolution modal - DON'T open add modal yet
                var dumpsiteData = {
                    geometry: cleanedGeometry,
                    name: '',
                    description: '',
                    isEnabled: false
                };
                showOverlapModal(dumpsiteData, overlaps);
            } else {
                // No overlaps, proceed normally
                var geoJsonFormat = new ol.format.GeoJSON();
                var geoJson = geoJsonFormat.writeFeature(event.feature);
                openAddPolygonModal(geoJson);
            }
        });
    }


    function openAddPolygonModal(geoJson) {
