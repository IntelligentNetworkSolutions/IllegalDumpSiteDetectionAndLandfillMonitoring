    function proceedFocusSelectedDumpsite(dumpsite) {
        var originalZIndex = $('#map-sidebar').css('z-index');

        if (dumpsite && dumpsite.geoJson) {
            var dumpsitesLayer = mapVars.map.getLayers().getArray().find(layer =>
                layer instanceof ol.layer.Vector && layer.get('title') === 'Registered Dumpsites'
            );

            if (dumpsitesLayer) {
                var features = dumpsitesLayer.getSource().getFeatures();

                features.forEach(function (feature) {
                    feature.setStyle(defaultStyle(feature.get('dumpsiteName'), feature.get('isEnabled')));
                });

                var selectedFeature = features.find(function (feature) {
                    return feature.get('id') === dumpsite.id;
                });

                if (selectedFeature) {
                    selectedFeature.setStyle(createFocusedStyle(dumpsite.name));

                    var extent = selectedFeature.getGeometry().getExtent();
                    mapVars.map.getView().fit(extent, {
                        padding: [150, 150, 150, 150],
                        duration: 1000
                    });

                    currentFocusedPolygon = selectedFeature;
                } else {
                    Swal.fire({
                        text: '@DbResHtml.T("Selected dumpsite not found", "Resources")',
                        confirmButtonText: '@DbResHtml.T("Ok", "Resources")',
                        didOpen: () => {
                            manageMapSidebarZIndex(originalZIndex, '1040');
                        },
                        willClose: () => {
                            manageMapSidebarZIndex(originalZIndex, '1040');
                        },
                        allowOutsideClick: false,
                        icon: "error"
                    });
                }
            } else {
                Swal.fire({
                    text: '@DbResHtml.T("Registered Dumpsites layer not found", "Resources")',
                    confirmButtonText: '@DbResHtml.T("Ok", "Resources")',
                    didOpen: () => {
                        manageMapSidebarZIndex(originalZIndex, '1040');
                    },
                    willClose: () => {
                        manageMapSidebarZIndex(originalZIndex, '1040');
                    },
                    allowOutsideClick: false,
                    icon: "error"
                });
            }
        } else {
            Swal.fire({
                text: '@DbResHtml.T("Invalid dumpsite data or missing geoJson", "Resources")',
                confirmButtonText: '@DbResHtml.T("Ok", "Resources")',
                didOpen: () => {
                    manageMapSidebarZIndex(originalZIndex, '1040');
                },
                willClose: () => {
                    manageMapSidebarZIndex(originalZIndex, '1040');
                },
                allowOutsideClick: false,
                icon: "error"
            });
        }
    }

    function resetAllFeaturesToDefaultStyle() {
        var dumpsitesLayer = mapVars.map.getLayers().getArray().find(layer =>
            layer instanceof ol.layer.Vector && layer.get('title') === 'Registered Dumpsites'
        );

        if (dumpsitesLayer) {
            dumpsitesLayer.getSource().getFeatures().forEach(function (feature) {
                let dumpsiteName = feature.get('dumpsiteName');
                let dumpsiteIsEnabled = feature.get('isEnabled');
                feature.setStyle(defaultStyle(dumpsiteName, dumpsiteIsEnabled));
            });
        }

        currentFocusedPolygon = null;
    }

