    function savePolygon() {
        var originalZIndex = $('#map-sidebar').css('z-index');
        var name = $("#dumpsiteName").val();
        var description = $("#dumpsiteDescription").val();
        var wasteTypeId = $("#dumpsiteWasteType").val();
        var riskLevelId = $("#dumpsiteRiskLevel").val();
        var isEnabled = $("#isDumpsiteEnabled").prop("checked");
        var geoJsonString = $("#polygonCoordinates").val();

        // Validation
        if (name.trim() === "") {
            showValidationError('@DbResHtml.T("Name is required", "Resources")', originalZIndex);
            return;
        }

        if (!wasteTypeId || wasteTypeId.trim() === "") {
            showValidationError('@DbResHtml.T("Waste Type is required", "Resources")', originalZIndex);
            return;
        }

        if (!riskLevelId || riskLevelId.trim() === "") {
            showValidationError('@DbResHtml.T("Risk Level is required", "Resources")', originalZIndex);
            return;
        }

        if (geoJsonString === '') {
            showValidationError('@DbResHtml.T("Please enter polygon", "Resources")', originalZIndex);
            return;
        }

        // Continue with save logic...
        var geoJsonObject = JSON.parse(geoJsonString);
        var geoJsonFormat = new ol.format.GeoJSON();
        var feature = geoJsonFormat.readFeature(geoJsonObject);
        var formattedGeoJson = geoJsonFormat.writeFeature(feature);

        $.ajax({
            type: "POST",
            url: "@Url.Action("AddRegisteredDumpsite", "RegisteredDumpsites", new { Area = "IntranetPortal" })",
            data: JSON.stringify({
                Name: name,
                Description: description,
                RegisteredDumpsiteWasteTypeId: wasteTypeId,
                RegisteredDumpsiteRiskLevelId: riskLevelId,
                EnteredZonePolygon: formattedGeoJson,
                IsEnabled: isEnabled
            }),
            contentType: "application/json",
            success: function (data) {
                $("#polygonModal").modal('hide');
                if (data != undefined || data != null) {
                    if (data.isSuccess == false && data.errMsg != null) {
                        Swal.fire({
                            text: `${data.errMsg}`,
                            confirmButtonText: '@DbResHtml.T("Ok", "Resources")',
                            didOpen: () => {
                                manageMapSidebarZIndex(originalZIndex, '1040');
                            },
                            willClose: () => {
                                manageMapSidebarZIndex(originalZIndex, '1040');
                            },
                            allowOutsideClick: false,
                            icon: "error"
                        });
                    }
                    else {
                        Swal.fire({
                            text: '@DbResHtml.T("Registered dumpsite saved successfully", "Resources")',
                            confirmButtonText: '@DbResHtml.T("Ok", "Resources")',
                            didOpen: () => {
                                manageMapSidebarZIndex(originalZIndex, '1040');
                            },
                            willClose: () => {
                                manageMapSidebarZIndex(originalZIndex, '1040');
                            },
                            allowOutsideClick: false,
                            icon: "success"
                        }).then((result) => {
                            if (result.isConfirmed) {
                                resetAddModalInputValues();
                                getAllRegisteredDumpsites();
                                generateRegisteredDumpsitesTable();
                            }
                        });
                    }
                }
                else {
                    Swal.fire({
                        text: `@DbResHtml.T("No data received", "Resources")`,
                        confirmButtonText: '@DbResHtml.T("Ok", "Resources")',
                        didOpen: () => {
                            manageMapSidebarZIndex(originalZIndex, '1040');
                        },
                        willClose: () => {
                            manageMapSidebarZIndex(originalZIndex, '1040');
                        },
                        allowOutsideClick: false,
                        icon: "error"
                    });
                }
            },
            error: function () {
                $("#polygonModal").modal('hide');
                Swal.fire({
                    text: '@DbResHtml.T("Error occurred while saving", "Resources")',
                    confirmButtonText: '@DbResHtml.T("Ok", "Resources")',
                    didOpen: () => {
                        manageMapSidebarZIndex(originalZIndex, '1040');
                    },
                    willClose: () => {
                        manageMapSidebarZIndex(originalZIndex, '1040');
                    },
                    allowOutsideClick: false,
                    icon: "error"
                });
            }
        });
    }
    function cleanupDrawInteraction() {
