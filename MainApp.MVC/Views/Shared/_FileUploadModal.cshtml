@using Westwind.Globalization.AspNetCore
@using MainApp.MVC.Helpers

<!-- File Upload Modal -->
<div class="modal fade" id="fileUploadModal" tabindex="-1" role="dialog" aria-labelledby="fileUploadModalLabel" aria-hidden="true" style="z-index:2200;">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-gradient-primary">
                <h5 class="modal-title" id="fileUploadModalLabel">
                    <i class="fas fa-upload"></i> @DbResHtml.T("Upload File", "Resources")
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="fileUploadForm" enctype="multipart/form-data">
                    <input type="hidden" id="uploadDumpsiteId" />
                    <div class="form-group">
                        <label for="fileInput">@DbResHtml.T("Select File", "Resources")</label>
                        <div class="custom-file">
                            <input type="file" class="custom-file-input" id="fileInput" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.gif,.txt,.xlsx,.xls">
                            <label class="custom-file-label" for="fileInput">@DbResHtml.T("Choose file", "Resources")</label>
                        </div>
                        <small class="form-text text-muted">
                            @DbResHtml.T("Supported formats: PDF, Word, Images, Excel, Text files", "Resources")
                        </small>
                    </div>
                    <div class="form-group">
                        <label for="fileDescription">@DbResHtml.T("Description", "Resources") (@DbResHtml.T("Optional", "Resources"))</label>
                        <textarea class="form-control" id="fileDescription" rows="3" placeholder="@DbResHtml.T("Add a description for this file", "Resources")"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">@DbResHtml.T("Cancel", "Resources")</button>
                <button type="button" class="btn btn-primary" onclick="uploadFile()">
                    <i class="fas fa-upload"></i> @DbResHtml.T("Upload", "Resources")
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Create Inspection Modal -->
<div class="modal fade" id="createInspectionModal" tabindex="-1" role="dialog" aria-labelledby="createInspectionModalLabel" aria-hidden="true" style="z-index:2200;">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-gradient-primary">
                <h5 class="modal-title" id="createInspectionModalLabel">
                    <i class="fas fa-plus"></i> @DbResHtml.T("Schedule Inspection", "Resources")
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="createInspectionForm">
                    <input type="hidden" id="inspectionDumpsiteId" />
                    <div class="form-group">
                        <label for="scheduledDate">@DbResHtml.T("Scheduled Date", "Resources") <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" id="scheduledDate" required>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">@DbResHtml.T("Cancel", "Resources")</button>
                <button type="button" class="btn btn-success" onclick="createInspection()"> 
                    <i class="fas fa-plus"></i> @DbResHtml.T("Schedule", "Resources")
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Assign Inspector Modal -->
<div class="modal fade" id="assignInspectorModal" tabindex="-1" role="dialog" aria-labelledby="assignInspectorModalLabel" aria-hidden="true" style="z-index:2200;">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-gradient-primary">
                <h5 class="modal-title" id="assignInspectorModalLabel">
                    <i class="fas fa-user-plus"></i> @DbResHtml.T("Assign Inspector", "Resources")
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="assignInspectorForm">
                    <input type="hidden" id="assignInspectionId" />
                    <div class="form-group">
                        <label for="inspectorSelect">@DbResHtml.T("Select Inspector", "Resources") <span class="text-danger">*</span></label>
                        <select class="form-control select2" id="inspectorSelect" required style="width: 100%;">
                            <option value="">@DbResHtml.T("Select Inspector", "Resources")</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">@DbResHtml.T("Cancel", "Resources")</button>
                <button type="button" class="btn btn-warning" onclick="assignInspector()">
                    <i class="fas fa-user-plus"></i> @DbResHtml.T("Assign", "Resources")
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Complete Inspection Modal -->
<div class="modal fade" id="completeInspectionModal" tabindex="-1" role="dialog" aria-labelledby="completeInspectionModalLabel" aria-hidden="true" style="z-index:2200;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-gradient-primary">
                <h5 class="modal-title" id="completeInspectionModalLabel">
                    <i class="fas fa-check"></i> @DbResHtml.T("Complete Inspection", "Resources")
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="completeInspectionForm">
                    <input type="hidden" id="completeInspectionId" />
                    <div class="form-group">
                        <label for="inspectionFindings">@DbResHtml.T("Findings", "Resources") <span class="text-danger">*</span></label>
                        <textarea class="form-control" id="inspectionFindings" rows="4" required placeholder="@DbResHtml.T("Describe the inspection findings", "Resources")"></textarea>
                    </div>
                    <div class="form-group">
                        <label for="inspectionRecommendations">@DbResHtml.T("Recommendations", "Resources")</label>
                        <textarea class="form-control" id="inspectionRecommendations" rows="3" placeholder="@DbResHtml.T("Add recommendations based on findings", "Resources")"></textarea>
                    </div>
                    <div class="form-group">
                        <label for="inspectionNotes">@DbResHtml.T("Notes", "Resources")</label>
                        <textarea class="form-control" id="inspectionNotes" rows="3" placeholder="@DbResHtml.T("Add notes based on findings", "Resources")"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">@DbResHtml.T("Cancel", "Resources")</button>
                <button type="button" class="btn btn-success" onclick="completeInspection()">
                    <i class="fas fa-check"></i> @DbResHtml.T("Complete", "Resources")
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Inspection File Upload Modal -->
<div class="modal fade" id="inspectionFileUploadModal" tabindex="-1" role="dialog" aria-labelledby="inspectionFileUploadModalLabel" aria-hidden="true" style="z-index:2200;">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-gradient-primary">
                <h5 class="modal-title" id="inspectionFileUploadModalLabel">
                    <i class="fas fa-upload"></i> @DbResHtml.T("Upload Inspection File", "Resources")
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="inspectionFileUploadForm" enctype="multipart/form-data">
                    <input type="hidden" id="uploadInspectionId" />
                    <div class="form-group">
                        <label for="inspectionFileInput">@DbResHtml.T("Select File", "Resources")</label>
                        <div class="custom-file">
                            <input type="file" class="custom-file-input" id="inspectionFileInput" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.gif,.txt,.xlsx,.xls">
                            <label class="custom-file-label" for="inspectionFileInput">@DbResHtml.T("Choose file", "Resources")</label>
                        </div>
                        <small class="form-text text-muted">
                            @DbResHtml.T("Supported formats: PDF, Word, Images, Excel, Text files", "Resources")
                        </small>
                    </div>
                    <div class="form-group">
                        <label for="inspectionFileDescription">@DbResHtml.T("Description", "Resources") (@DbResHtml.T("Optional", "Resources"))</label>
                        <textarea class="form-control" id="inspectionFileDescription" rows="3" placeholder="@DbResHtml.T("Add a description for this inspection file", "Resources")"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">@DbResHtml.T("Cancel", "Resources")</button>
                <button type="button" class="btn btn-primary" onclick="uploadInspectionFile()">
                    <i class="fas fa-upload"></i> @DbResHtml.T("Upload", "Resources")
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Inspection Files View Modal -->
<div class="modal fade" id="inspectionFilesModal" tabindex="-1" role="dialog" aria-labelledby="inspectionFilesModalLabel" aria-hidden="true" style="z-index:1050;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-gradient-primary">
                <h5 class="modal-title" id="inspectionFilesModalLabel">
                    <i class="fas fa-file"></i> @DbResHtml.T("Inspection Files", "Resources")
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div id="inspectionFilesContent">
                    <!-- Files will be loaded here -->
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">@DbResHtml.T("Close", "Resources")</button>
            </div>
        </div>
    </div>
</div>

<script>
       // Updated JavaScript for modals with proper toast notifications and fixes

    function showFileUploadModal(dumpsiteId) {
        $('#uploadDumpsiteId').val(dumpsiteId);
        $('#fileInput').val('');
        $('#fileDescription').val('');
        $('.custom-file-label').text('Choose file');
        $('#fileUploadModal').modal('show');
    }

    function showCreateInspectionModal(dumpsiteId) {
        $('#inspectionDumpsiteId').val(dumpsiteId);
        $('#scheduledDate').val('');
        $('#createInspectionModal').modal('show');
    }

    function showAssignInspectorModal(inspectionId) {
        $('#assignInspectionId').val(inspectionId);
        loadInspectors(function() {
            $('#assignInspectorModal').modal('show');
        });
    }


    function showCompleteInspectionModal(inspectionId) {
        $('#completeInspectionId').val(inspectionId);
        $('#inspectionFindings').val('');
        $('#inspectionRecommendations').val('');
        $('#inspectionNotes').val('');
        $('#completeInspectionModal').modal('show');
    }

    function viewInspectionDetails(inspectionId) {
        $.get('@Url.Action("GetInspectionDetails", "RegisteredDumpsites", new { Area = "IntranetPortal" })', { inspectionId: inspectionId })
            .done(function(result) {
                if (result.isSuccess) {
                    showInspectionDetailsModal(result.data);
                } else {
                    Swal.fire({
                        title: '@DbResHtml.T("Error", "Resources")',
                        text: result.errMsg || '@DbResHtml.T("Error loading inspection details", "Resources")',
                        icon: 'error',
                        confirmButtonText: '@DbResHtml.T("Ok", "Resources")'
                    });
                }
            })
            .fail(function() {
                Swal.fire({
                    title: '@DbResHtml.T("Error", "Resources")',
                    text: '@DbResHtml.T("Error loading inspection details", "Resources")',
                    icon: 'error',
                    confirmButtonText: '@DbResHtml.T("Ok", "Resources")'
                });
            });
    }

        function formatDate(date) {
        const d = new Date(date);
        const day = String(d.getDate()).padStart(2, '0');
        const month = String(d.getMonth() + 1).padStart(2, '0');
        const year = d.getFullYear();
        const hours = String(d.getHours()).padStart(2, '0');
        const minutes = String(d.getMinutes()).padStart(2, '0');

        // Return the formatted date in the desired format
        return `${day}/${month}/${year} ${hours}:${minutes}`;
    }

    function showInspectionDetailsModal(inspection) {

    let formattedScheduledDate = inspection.scheduledDate ? formatDate(inspection.scheduledDate) : '-';
    let formattedInspectionDate = inspection.inspectionDate ? formatDate(inspection.inspectionDate) : '-';

        let modalContent = `
            <div class="modal fade" id="inspectionDetailsModal" tabindex="-1" role="dialog" style="z-index:2300">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header bg-gradient-primary">
                            <h5 class="modal-title">Inspection Details</h5>
                            <button type="button" class="close" data-dismiss="modal">&times;</button>
                        </div>
                        <div class="modal-body">
                            <table class="table">
                                <tr><td><strong>Scheduled Date:</strong></td><td>${formattedScheduledDate}</td></tr>
                                <tr><td><strong>Inspector:</strong></td><td>${inspection.inspector?.userName || 'Not Assigned'}</td></tr>
                                <tr><td><strong>Status:</strong></td><td>${inspection.status}</td></tr>
                                <tr><td><strong>Inspection Date:</strong></td><td>${formattedInspectionDate}</td></tr>
                                <tr>
                                    <td><strong>Findings:</strong></td>
                                    <td class="text-wrap text-break" style="max-height: 300px; overflow-y: auto;">${inspection.findings || '-'}</td>
                                </tr>
                                <tr>
                                    <td><strong>Recommendations:</strong></td>
                                    <td class="text-wrap text-break" style="max-height: 300px; overflow-y: auto;">${inspection.recommendations || '-'}</td>
                                </tr>
                                <tr><td><strong>Notes:</strong></td><td>${inspection.notes || '-'}</td></tr>
                            </table>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>
        `;

        // Remove existing modal if present
        $('#inspectionDetailsModal').remove();

        // Add modal to body and show
        $('body').append(modalContent);
        $('#inspectionDetailsModal').modal('show');

        // Remove modal from DOM when hidden
        $('#inspectionDetailsModal').on('hidden.bs.modal', function () {
            $(this).remove();
        });
    }

    function uploadFile() {
        var formData = new FormData();
        var fileInput = document.getElementById('fileInput');
        var dumpsiteId = $('#uploadDumpsiteId').val();
        var description = $('#fileDescription').val();

        if (fileInput.files.length === 0) {
            Swal.fire({
                title: '@DbResHtml.T("Error", "Resources")',
                text: '@DbResHtml.T("Please select a file", "Resources")',
                icon: 'error',
                confirmButtonText: '@DbResHtml.T("Ok", "Resources")'
            });
            return;
        }

        formData.append('file', fileInput.files[0]);
        formData.append('dumpsiteId', dumpsiteId);
        formData.append('description', description);

        $.ajax({
            url: '@Url.Action("UploadDumpsiteFile", "RegisteredDumpsites", new { Area = "IntranetPortal" })',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function(result) {
                if (result.isSuccess) {
                    Swal.fire({
                        title: '@DbResHtml.T("Success", "Resources")',
                        text: '@DbResHtml.T("File uploaded successfully", "Resources")',
                        icon: 'success',
                        confirmButtonText: '@DbResHtml.T("Ok", "Resources")'
                    });
                    $('#fileUploadModal').modal('hide');
                    refreshDetails();
                } else {
                    Swal.fire({
                        title: '@DbResHtml.T("Error", "Resources")',
                        text: result.errMsg || '@DbResHtml.T("Error uploading file", "Resources")',
                        icon: 'error',
                        confirmButtonText: '@DbResHtml.T("Ok", "Resources")'
                    });
                }
            },
            error: function() {
                Swal.fire({
                    title: '@DbResHtml.T("Error", "Resources")',
                    text: '@DbResHtml.T("Error uploading file", "Resources")',
                    icon: 'error',
                    confirmButtonText: '@DbResHtml.T("Ok", "Resources")'
                });
            }
        });
    }

    function createInspection() {
        var inspection = {
            RegisteredDumpsiteId: $('#inspectionDumpsiteId').val(),
            ScheduledDate: $('#scheduledDate').val(),
        };

        $.ajax({
            url: '@Url.Action("CreateInspection", "RegisteredDumpsites", new { Area = "IntranetPortal" })',
            type: 'POST',
            data: JSON.stringify(inspection),
            contentType: 'application/json',
            success: function(result) {
                if (result.isSuccess) {
                    Swal.fire({
                        title: '@DbResHtml.T("Success", "Resources")',
                        text: '@DbResHtml.T("Inspection scheduled successfully", "Resources")',
                        icon: 'success',
                        confirmButtonText: '@DbResHtml.T("Ok", "Resources")'
                    });
                    $('#createInspectionModal').modal('hide');
                    refreshDetails();
                } else {
                    Swal.fire({
                        title: '@DbResHtml.T("Error", "Resources")',
                        text: result.errMsg || '@DbResHtml.T("Error scheduling inspection", "Resources")',
                        icon: 'error',
                        confirmButtonText: '@DbResHtml.T("Ok", "Resources")'
                    });
                }
            },
            error: function() {
                Swal.fire({
                    title: '@DbResHtml.T("Error", "Resources")',
                    text: '@DbResHtml.T("Error scheduling inspection", "Resources")',
                    icon: 'error',
                    confirmButtonText: '@DbResHtml.T("Ok", "Resources")'
                });
            }
        });
    }

    function assignInspector() {
        var inspectionId = $('#assignInspectionId').val();
        var inspectorId = $('#inspectorSelect').val();

        if (!inspectorId) {
            Swal.fire({
                title: '@DbResHtml.T("Error", "Resources")',
                text: '@DbResHtml.T("Please select an inspector", "Resources")',
                icon: 'error',
                confirmButtonText: '@DbResHtml.T("Ok", "Resources")'
            });
            return;
        }

        $.ajax({
            url: '@Url.Action("AssignInspector", "RegisteredDumpsites", new { Area = "IntranetPortal" })',
            type: 'POST',
            data: JSON.stringify({
                inspectionId: inspectionId,
                inspectorId: inspectorId
            }),
            contentType: 'application/json',
            success: function(result) {
                if (result.isSuccess) {
                    Swal.fire({
                        title: '@DbResHtml.T("Success", "Resources")',
                        text: '@DbResHtml.T("Inspector assigned successfully", "Resources")',
                        icon: 'success',
                        confirmButtonText: '@DbResHtml.T("Ok", "Resources")'
                    });
                    $('#assignInspectorModal').modal('hide');
                    refreshDetails();
                } else {
                    $('#assignInspectorModal').modal('hide');
                    Swal.fire({
                        title: '@DbResHtml.T("Error", "Resources")',
                        text: result.errMsg || '@DbResHtml.T("Error assigning inspector", "Resources")',
                        icon: 'error',
                        confirmButtonText: '@DbResHtml.T("Ok", "Resources")'
                    });
                }
            },
            error: function() {
                Swal.fire({
                    title: '@DbResHtml.T("Error", "Resources")',
                    text: '@DbResHtml.T("Error assigning inspector", "Resources")',
                    icon: 'error',
                    confirmButtonText: '@DbResHtml.T("Ok", "Resources")'
                });
            }
        });
    }

    function completeInspection() {
        var inspectionId = $('#completeInspectionId').val();
        var findings = $('#inspectionFindings').val();
        var recommendations = $('#inspectionRecommendations').val();
        var notes = $('#inspectionNotes').val();

        if (!findings.trim()) {
            Swal.fire({
                title: '@DbResHtml.T("Error", "Resources")',
                text: '@DbResHtml.T("Please enter findings", "Resources")',
                icon: 'error',
                confirmButtonText: '@DbResHtml.T("Ok", "Resources")'
            });
            return;
        }

        $.ajax({
            url: '@Url.Action("CompleteInspection", "RegisteredDumpsites", new { Area = "IntranetPortal" })',
            type: 'POST',
            data: JSON.stringify({
                inspectionId: inspectionId,
                findings: findings,
                recommendations: recommendations,
                notes: notes
            }),
            contentType: 'application/json',
            success: function(result) {
                if (result.isSuccess) {
                    Swal.fire({
                        title: '@DbResHtml.T("Success", "Resources")',
                        text: '@DbResHtml.T("Inspection completed successfully", "Resources")',
                        icon: 'success',
                        confirmButtonText: '@DbResHtml.T("Ok", "Resources")'
                    });
                    $('#completeInspectionModal').modal('hide');
                    refreshDetails();
                } else {
                    Swal.fire({
                        title: '@DbResHtml.T("Error", "Resources")',
                        text: result.errMsg || '@DbResHtml.T("Error completing inspection", "Resources")',
                        icon: 'error',
                        confirmButtonText: '@DbResHtml.T("Ok", "Resources")'
                    });
                }
            },
            error: function() {
                Swal.fire({
                    title: '@DbResHtml.T("Error", "Resources")',
                    text: '@DbResHtml.T("Error completing inspection", "Resources")',
                    icon: 'error',
                    confirmButtonText: '@DbResHtml.T("Ok", "Resources")'
                });
            }
        });
    }
    function deleteDumpsiteFile(fileId) {
        Swal.fire({
            title: 'Delete File?',
            text: 'Are you sure you want to delete this file? This action can\'t be undone!',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes',
            cancelButtonText: 'No',
            customClass: {
                confirmButton: 'btn btn-lg btn-danger',
                cancelButton: 'btn btn-lg btn-default me-2'
            },
            focusConfirm: false
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '@Url.Action("DeleteDumpsiteFile", "RegisteredDumpsites", new { Area = "IntranetPortal" })',
                    type: 'POST',
                    data: { fileId: fileId },
                    success: function(result) {
                        if (result.isSuccess) {
                            Swal.fire({
                                title: 'Success',
                                text: 'File deleted successfully',
                                icon: 'success',
                                confirmButtonText: 'OK'
                            });
                            refreshDetails();
                        } else {
                            Swal.fire({
                                title: 'Error',
                                text: result.errMsg,
                                icon: 'error',
                                confirmButtonText: 'OK'
                            });
                        }
                    },
                    error: function() {
                        Swal.fire({
                            title: 'Error',
                            text: 'Error deleting file',
                            icon: 'error',
                            confirmButtonText: 'OK'
                        });
                    }
                });
            }
        });
    }

    function loadInspectors(callback) {
        $.get('@Url.Action("GetAvailableInspectors", "RegisteredDumpsites", new { Area = "IntranetPortal" })')
            .done(function(result) {
                var select = $('#inspectorSelect');
                select.empty().append('<option value="">Select Inspector</option>');

                if (result.isSuccess && result.data) {
                    result.data.forEach(function(inspector) {
                        select.append($('<option>', {
                            value: inspector.id,
                            text: inspector.userName || inspector.fullName
                        }));
                    });
                }

                if (callback) callback();
            })
            .fail(function() {
                Swal.fire({
                    title: '@DbResHtml.T("Error", "Resources")',
                    text: '@DbResHtml.T("Error loading inspectors", "Resources")',
                    icon: 'error',
                    confirmButtonText: '@DbResHtml.T("Ok", "Resources")'
                });
            });
    }

    function refreshDetails() {
    let dumpsiteId = $('#dumpsiteDetailsModal').data('dumpsite-id');
    refreshDumpsiteDetails(dumpsiteId);
    }

       function showInspectionFileUploadModal(inspectionId) {
        $.get('@Url.Action("CheckInspectionAssignment", "RegisteredDumpsites", new { Area = "IntranetPortal" })', { inspectionId: inspectionId })
            .done(function(result) {
                if (result.isSuccess && result.data) {
                    $('#uploadInspectionId').val(inspectionId);
                    $('#inspectionFileInput').val('');
                    $('#inspectionFileDescription').val('');
                    $('.custom-file-label').text('Choose file');
                    $('#inspectionFileUploadModal').modal('show');
                } else {
                    Swal.fire({
                        title: '@DbResHtml.T("Error", "Resources")',
                        text: '@DbResHtml.T("You are not assigned to this inspection", "Resources")',
                        icon: 'error',
                        confirmButtonText: '@DbResHtml.T("Ok", "Resources")'
                    });
                }
            })
            .fail(function() {
                Swal.fire({
                    title: '@DbResHtml.T("Error", "Resources")',
                    text: '@DbResHtml.T("Error checking inspection assignment", "Resources")',
                    icon: 'error',
                    confirmButtonText: '@DbResHtml.T("Ok", "Resources")'
                });
            });
    }

    function uploadInspectionFile() {
        var formData = new FormData();
        var fileInput = document.getElementById('inspectionFileInput');
        var inspectionId = $('#uploadInspectionId').val();
        var description = $('#inspectionFileDescription').val();

        if (fileInput.files.length === 0) {
            Swal.fire({
                title: '@DbResHtml.T("Error", "Resources")',
                text: '@DbResHtml.T("Please select a file", "Resources")',
                icon: 'error',
                confirmButtonText: '@DbResHtml.T("Ok", "Resources")'
            });
            return;
        }

        formData.append('file', fileInput.files[0]);
        formData.append('inspectionId', inspectionId);
        formData.append('description', description);

        $.ajax({
            url: '@Url.Action("UploadInspectionFile", "RegisteredDumpsites", new { Area = "IntranetPortal" })',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function(result) {
                if (result.isSuccess) {
                    Swal.fire({
                        title: '@DbResHtml.T("Success", "Resources")',
                        text: '@DbResHtml.T("Inspection file uploaded successfully", "Resources")',
                        icon: 'success',
                        confirmButtonText: '@DbResHtml.T("Ok", "Resources")'
                    });
                    $('#inspectionFileUploadModal').modal('hide');
                    refreshDetails();
                } else {
                    Swal.fire({
                        title: '@DbResHtml.T("Error", "Resources")',
                        text: result.errMsg || '@DbResHtml.T("Error uploading inspection file", "Resources")',
                        icon: 'error',
                        confirmButtonText: '@DbResHtml.T("Ok", "Resources")'
                    });
                }
            },
            error: function() {
                Swal.fire({
                    title: '@DbResHtml.T("Error", "Resources")',
                    text: '@DbResHtml.T("Error uploading inspection file", "Resources")',
                    icon: 'error',
                    confirmButtonText: '@DbResHtml.T("Ok", "Resources")'
                });
            }
        });
    }

    function viewInspectionFiles(inspectionId) {
        $.get('@Url.Action("GetInspectionFiles", "RegisteredDumpsites", new { Area = "IntranetPortal" })', { inspectionId: inspectionId })
            .done(function(result) {
                if (result.isSuccess) {
                    displayInspectionFiles(result.data);
                    $('#inspectionFilesModal').modal('show');
                } else {
                    Swal.fire({
                        title: '@DbResHtml.T("Error", "Resources")',
                        text: result.errMsg || '@DbResHtml.T("Error loading inspection files", "Resources")',
                        icon: 'error',
                        confirmButtonText: '@DbResHtml.T("Ok", "Resources")'
                    });
                }
            })
            .fail(function() {
                Swal.fire({
                    title: '@DbResHtml.T("Error", "Resources")',
                    text: '@DbResHtml.T("Error loading inspection files", "Resources")',
                    icon: 'error',
                    confirmButtonText: '@DbResHtml.T("Ok", "Resources")'
                });
            });
    }
    function displayInspectionFiles(files) {
        var content = $('#inspectionFilesContent');
        content.empty();

        if (files && files.length > 0) {
            var filesList = '<div class="list-group">';

            files.forEach(function(file) {
                filesList += `
                    <div class="list-group-item">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-1">${file.originalFileName}</h6>
                                <small class="text-muted">Uploaded: ${new Date(file.createdOn).toLocaleDateString()}</small>
                                ${file.description ? `<br><small class="text-info">${file.description}</small>` : ''}
                                <br><small class="text-muted">By: ${file.createdBy?.userName || 'Unknown'}</small>
                            </div>
                            <div class="btn-group">
                                <a href="@Url.Action("DownloadInspectionFile", "RegisteredDumpsites", new { Area = "IntranetPortal" })?fileId=${file.id}"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-download"></i> Download
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteInspectionFile('${file.id}')">
                                    <i class="fas fa-trash"></i> Delete
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            });

            filesList += '</div>';
            content.html(filesList);
        } else {
            content.html('<p class="text-muted text-center">No inspection files uploaded yet</p>');
        }
    }

    function deleteInspectionFile(fileId) {
        Swal.fire({
            title: 'Delete File?',
            text: 'Are you sure you want to delete this inspection file? This action can\'t be undone!',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes',
            cancelButtonText: 'No',
            customClass: {
                confirmButton: 'btn btn-lg btn-danger',
                cancelButton: 'btn btn-lg btn-default me-2'
            },
            focusConfirm: false
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '@Url.Action("DeleteInspectionFile", "RegisteredDumpsites", new { Area = "IntranetPortal" })',
                    type: 'POST',
                    data: { fileId: fileId },
                    success: function(result) {
                        if (result.isSuccess) {
                            Swal.fire({
                                title: 'Success',
                                text: 'Inspection file deleted successfully',
                                icon: 'success',
                                confirmButtonText: 'OK'
                            });
                            if ($('#inspectionFilesModal').hasClass('show')) {
                                var inspectionId = $('#uploadInspectionId').val();
                                if (inspectionId) {
                                    viewInspectionFiles(inspectionId);
                                }
                            }
                            $('#inspectionFilesModal').modal('hide');
                            refreshDetails();
                        } else {
                            Swal.fire({
                                title: 'Error',
                                text: result.errMsg,
                                icon: 'error',
                                confirmButtonText: 'OK'
                            });
                        }
                    },
                    error: function() {
                        Swal.fire({
                            title: 'Error',
                            text: 'Error deleting inspection file',
                            icon: 'error',
                            confirmButtonText: 'OK'
                        });
                    }
                });
            }
        });
    }

    // Update file input label for inspection files
    $(document).ready(function() {
        $('#inspectionFileInput').on('change', function() {
            var fileName = $(this).val().split('\\').pop();
            $(this).next('.custom-file-label').text(fileName || 'Choose file');
        });
    });
    // File input label update
    $(document).ready(function() {
        $('#fileInput').on('change', function() {
            var fileName = $(this).val().split('\\').pop();
            $('.custom-file-label').text(fileName || 'Choose file');
        });
    });

 </script>